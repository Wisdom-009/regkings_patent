          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n/* REGKINGS PHARMACY PAGE */\n.regkings {\n  --rk-navy: #071b2b;\n  --rk-green: #20c878;\n  --rk-light: #f4f8f6;\n  --rk-muted: #b8c9d3;\n  font-family: Arial, Helvetica, sans-serif;\n  color: var(--rk-light);\n  background: var(--rk-navy);\n  line-height: 1.7;\n  overflow: hidden;\n}\n\n.regkings * {\n  box-sizing: border-box;\n}\n\n.regkings a {\n  text-decoration: none;\n}\n\n.regkings .rk-container {\n  width: 92%;\n  max-width: 1180px;\n  margin: auto;\n}\n\n/* NAVIGATION */\n.regkings .rk-nav {\n  background: #061522;\n  border-bottom: 1px solid rgba(32,200,120,.2);\n  position: relative;\n  z-index: 20;\n}\n\n.regkings .rk-nav-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  min-height: 82px;\n}\n\n.regkings .rk-brand {\n  color: #fff;\n  font-size: 20px;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.regkings .rk-brand span {\n  display: block;\n  color: var(--rk-green);\n  font-size: 12px;\n  letter-spacing: 2px;\n  margin-top: 5px;\n}\n\n.regkings .rk-menu {\n  display: flex;\n  align-items: center;\n  gap: 19px;\n}\n\n.regkings .rk-menu a {\n  color: #e1eaf0;\n  font-size: 13px;\n  transition: color .25s;\n}\n\n.regkings .rk-menu a:hover,\n.regkings .rk-menu a.rk-active {\n  color: var(--rk-green);\n}\n\n.regkings .rk-menu-btn {\n  display: none;\n  background: transparent;\n  color: #fff;\n  border: 1px solid #365064;\n  padding: 8px 12px;\n  border-radius: 6px;\n  font-size: 22px;\n  cursor: pointer;\n}\n\n/* BUTTONS */\n.regkings .rk-btn {\n  display: inline-block;\n  background: var(--rk-green);\n  color: #061b2b;\n  font-weight: 700;\n  padding: 13px 23px;\n  border-radius: 6px;\n  transition: .25s;\n}\n\n.regkings .rk-btn:hover {\n  background: #43e394;\n  transform: translateY(-2px);\n}\n\n.regkings .rk-btn-outline {\n  display: inline-block;\n  color: #fff;\n  border: 1px solid #6b8796;\n  padding: 12px 22px;\n  border-radius: 6px;\n  transition: .25s;\n}\n\n.regkings .rk-btn-outline:hover {\n  border-color: var(--rk-green);\n  color: var(--rk-green);\n}\n\n/* HERO */\n.regkings .rk-hero {\n  padding: 95px 0;\n  background:\n    radial-gradient(ellipse at 85% 30%, rgba(32,200,120,.15), transparent 42%),\n    linear-gradient(135deg, #071b2b 0%, #0b293b 100%);\n}\n\n.regkings .rk-hero-grid {\n  display: grid;\n  grid-template-columns: 1.2fr .8fr;\n  align-items: center;\n  gap: 55px;\n}\n\n.regkings .rk-eyebrow {\n  color: var(--rk-green);\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 3px;\n  text-transform: uppercase;\n}\n\n.regkings .rk-hero h1 {\n  color: #fff;\n  font-size: clamp(38px, 5vw, 61px);\n  line-height: 1.12;\n  margin: 18px 0;\n}\n\n.regkings .rk-hero h1 span {\n  color: var(--rk-green);\n}\n\n.regkings .rk-hero p {\n  color: var(--rk-muted);\n  font-size: 16px;\n  max-width: 590px;\n  margin-bottom: 28px;\n}\n\n.regkings .rk-hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 13px;\n}\n\n.regkings .rk-hero-card {\n  background: rgba(255,255,255,.045);\n  border: 1px solid rgba(255,255,255,.12);\n  padding: 32px;\n  border-radius: 16px;\n  box-shadow: 0 18px 45px rgba(0,0,0,.18);\n}\n\n.regkings .rk-hero-icon {\n  width: 75px;\n  height: 75px;\n  border-radius: 18px;\n  background: rgba(32,200,120,.12);\n  border: 1px solid rgba(32,200,120,.3);\n  display: grid;\n  place-items: center;\n  color: var(--rk-green);\n  font-size: 38px;\n  margin-bottom: 22px;\n}\n\n.regkings .rk-hero-card h3 {\n  color: #fff;\n  font-size: 23px;\n  margin: 0 0 12px;\n}\n\n.regkings .rk-hero-card p {\n  font-size: 14px;\n  margin: 0;\n}\n\n/* SECTION HEADINGS */\n.regkings .rk-section {\n  padding: 78px 0;\n}\n\n.regkings .rk-section-light {\n  background: #f4f8f6;\n  color: #102b3b;\n}\n\n.regkings .rk-heading {\n  max-width: 700px;\n  margin: 0 auto 42px;\n  text-align: center;\n}\n\n.regkings .rk-heading .rk-eyebrow {\n  display: block;\n  margin-bottom: 10px;\n}\n\n.regkings .rk-heading h2 {\n  font-size: clamp(28px, 4vw, 40px);\n  line-height: 1.2;\n  margin: 0 0 14px;\n}\n\n.regkings .rk-heading p {\n  color: #6a7c86;\n  margin: 0;\n}\n\n/* CATEGORY CARDS */\n.regkings .rk-categories {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 22px;\n}\n\n.regkings .rk-category {\n  background: #fff;\n  border: 1px solid #e0e9e4;\n  border-radius: 12px;\n  padding: 28px;\n  transition: transform .25s, box-shadow .25s;\n}\n\n.regkings .rk-category:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 15px 35px rgba(9,40,30,.09);\n}\n\n.regkings .rk-category-icon {\n  width: 58px;\n  height: 58px;\n  display: grid;\n  place-items: center;\n  border-radius: 12px;\n  background: #e5f8ee;\n  font-size: 28px;\n  margin-bottom: 19px;\n}\n\n.regkings .rk-category h3 {\n  color: #102b3b;\n  font-size: 19px;\n  margin: 0 0 10px;\n}\n\n.regkings .rk-category p {\n  color: #6a7c86;\n  font-size: 14px;\n  margin: 0;\n}\n\n/* RESPONSIBLE MEDICINE USE */\n.regkings .rk-safety-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 45px;\n  align-items: center;\n}\n\n.regkings .rk-safety-panel {\n  background: #0c2a3b;\n  border: 1px solid rgba(32,200,120,.2);\n  border-radius: 14px;\n  padding: 30px;\n}\n\n.regkings .rk-safety-panel h3 {\n  color: #fff;\n  font-size: 23px;\n  margin: 0 0 20px;\n}\n\n.regkings .rk-safety-item {\n  display: flex;\n  gap: 13px;\n  margin: 17px 0;\n  color: var(--rk-muted);\n  font-size: 14px;\n}\n\n.regkings .rk-check {\n  color: var(--rk-green);\n  font-weight: 800;\n  font-size: 18px;\n}\n\n.regkings .rk-safety-copy h2 {\n  color: #fff;\n  font-size: clamp(28px, 4vw, 39px);\n  line-height: 1.2;\n  margin: 12px 0 18px;\n}\n\n.regkings .rk-safety-copy p {\n  color: var(--rk-muted);\n}\n\n.regkings .rk-safety-copy .rk-btn {\n  margin-top: 12px;\n}\n\n/* CONTACT BANNER */\n.regkings .rk-contact {\n  padding: 65px 0;\n  background: linear-gradient(110deg, #0d4938, #08764b);\n}\n\n.regkings .rk-contact-inner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 30px;\n}\n\n.regkings .rk-contact h2 {\n  color: #fff;\n  font-size: clamp(25px, 4vw, 36px);\n  margin: 0 0 10px;\n}\n\n.regkings .rk-contact p {\n  color: #d6eee3;\n  margin: 0;\n}\n\n.regkings .rk-contact .rk-btn {\n  background: #fff;\n  color: #0b4835;\n  white-space: nowrap;\n}\n\n/* FOOTER */\n.regkings .rk-footer {\n  background: #04121d;\n  padding: 35px 0 20px;\n  border-top: 1px solid rgba(255,255,255,.07);\n}\n\n.regkings .rk-footer-inner {\n  display: flex;\n  justify-content: space-between;\n  gap: 25px;\n  flex-wrap: wrap;\n}\n\n.regkings .rk-footer p {\n  color: #91a6b2;\n  font-size: 13px;\n  margin: 8px 0;\n}\n\n.regkings .rk-footer-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 16px;\n}\n\n.regkings .rk-footer-links a {\n  color: #c9d7de;\n  font-size: 13px;\n}\n\n.regkings .rk-footer-links a:hover {\n  color: var(--rk-green);\n}\n\n.regkings .rk-copyright {\n  border-top: 1px solid rgba(255,255,255,.08);\n  margin-top: 24px;\n  padding-top: 18px;\n  color: #8297a3;\n  font-size: 12px;\n}\n\n/* MOBILE RESPONSIVENESS */\n@media (max-width: 1000px) {\n  .regkings .rk-menu {\n    gap: 12px;\n  }\n\n  .regkings .rk-menu a {\n    font-size: 12px;\n  }\n\n  .regkings .rk-hero-grid {\n    gap: 30px;\n  }\n\n  .regkings .rk-categories {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 760px) {\n  .regkings .rk-nav-inner {\n    min-height: 72px;\n    flex-wrap: wrap;\n    padding: 15px 0;\n  }\n\n  .regkings .rk-menu-btn {\n    display: block;\n  }\n\n  .regkings .rk-menu {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 0;\n    padding: 8px 0;\n  }\n\n  .regkings .rk-menu.rk-menu-open {\n    display: flex;\n  }\n\n  .regkings .rk-menu a {\n    padding: 11px 4px;\n    border-bottom: 1px solid rgba(255,255,255,.07);\n    font-size: 14px;\n  }\n\n  .regkings .rk-hero {\n    padding: 65px 0;\n  }\n\n  .regkings .rk-hero-grid,\n  .regkings .rk-safety-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .regkings .rk-hero-card {\n    padding: 25px;\n  }\n\n  .regkings .rk-section {\n    padding: 58px 0;\n  }\n\n  .regkings .rk-categories {\n    grid-template-columns: 1fr;\n  }\n\n  .regkings .rk-contact-inner {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .regkings .rk-contact .rk-btn {\n    white-space: normal;\n  }\n}\n</style>\n\n<div class=\"regkings\">\n\n  <!-- NAVIGATION -->\n  <header class=\"rk-nav\">\n    <div class=\"rk-container rk-nav-inner\">\n      <a href=\"home.html\" class=\"rk-brand\">\n        RegKings\n        <span>PATENT &amp; COSMETIC STORES</span>\n      </a>\n\n      <button class=\"rk-menu-btn\" type=\"button\" aria-label=\"Toggle navigation\" aria-expanded=\"false\" onclick=\"(function(b){var m=b.parentElement.querySelector('.rk-menu');var o=m.classList.toggle('rk-menu-open');b.setAttribute('aria-expanded',o?'true':'false');})(this)\">\n        ☰\n      </button>\n\n      <nav class=\"rk-menu\" aria-label=\"Main navigation\">\n        <a href=\"home.html\">Home</a>\n        <a href=\"about.html\">About</a>\n        <a href=\"pharmacy.html\" class=\"rk-active\">Pharmacy</a>\n        <a href=\"patents.html\">Patent Medicines</a>\n        <a href=\"cosmetics.html\">Cosmetics</a>\n        <a href=\"products.html\">Products</a>\n        <a href=\"contact.html\">Contact</a>\n        <a href=\"visit.html\">Visit Us</a>\n      </nav>\n    </div>\n  </header>\n\n  <!-- HERO -->\n  <section class=\"rk-hero\">\n    <div class=\"rk-container rk-hero-grid\">\n      <div>\n        <span class=\"rk-eyebrow\">RegKings Pharmacy</span>\n        <h1>Health and Wellness, <span>With Care.</span></h1>\n        <p>\n          Explore our pharmacy information and ask our team about product\n          availability, appropriate use, and the right next step for your\n          healthcare needs.\n        </p>\n\n        <div class=\"rk-hero-actions\">\n          <a href=\"contact.html\" class=\"rk-btn\">Contact Our Team</a>\n          <a href=\"#rk-categories\" class=\"rk-btn-outline\">Explore Categories</a>\n        </div>\n      </div>\n\n      <div class=\"rk-hero-card\">\n        <div class=\"rk-hero-icon\">✚</div>\n        <h3>Your Health Matters</h3>\n        <p>\n          Making informed choices is important. Ask a qualified healthcare\n          professional for advice when you have questions about medicines,\n          symptoms, or treatment.\n        </p>\n      </div>\n    </div>\n  </section>\n\n  <!-- PHARMACY CATEGORIES -->\n  <section class=\"rk-section rk-section-light\" id=\"rk-categories\">\n    <div class=\"rk-container\">\n      <div class=\"rk-heading\">\n        <span class=\"rk-eyebrow\">Pharmacy Categories</span>\n        <h2>Explore Our Pharmacy Range</h2>\n        <p>\n          These are general product categories to enquire about.\n          Availability may vary, so please contact us or visit the store\n          to confirm what is currently in stock.\n        </p>\n      </div>\n\n      <div class=\"rk-categories\">\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-icon\">💊</div>\n          <h3>Medicines</h3>\n          <p>\n            Enquire about available medicines and obtain appropriate guidance\n            on their safe and responsible use.\n          </p>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-icon\">🩹</div>\n          <h3>First-Aid Essentials</h3>\n          <p>\n            Ask about basic first-aid supplies and other healthcare essentials\n            that may be available in store.\n          </p>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-icon\">🧴</div>\n          <h3>Personal Care</h3>\n          <p>\n            Explore personal hygiene and everyday care products suited to\n            your needs.\n          </p>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-icon\">🌿</div>\n          <h3>Health &amp; Wellness</h3>\n          <p>\n            Enquire about available wellness products and seek professional\n            advice before using supplements or new treatments.\n          </p>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-icon\">🧼</div>\n          <h3>Hygiene Products</h3>\n          <p>\n            Ask about hygiene and everyday household care products available\n            through the store.\n          </p>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-icon\">🤝</div>\n          <h3>Product Enquiries</h3>\n          <p>\n            Need a particular item? Contact us to ask about availability\n            before making a visit.\n          </p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- RESPONSIBLE MEDICINE USE -->\n  <section class=\"rk-section\">\n    <div class=\"rk-container rk-safety-grid\">\n\n      <div class=\"rk-safety-panel\">\n        <h3>Important Medicine Safety Tips</h3>\n\n        <div class=\"rk-safety-item\">\n          <span class=\"rk-check\">✓</span>\n          <span>Use medicines according to the directions of a qualified healthcare professional.</span>\n        </div>\n\n        <div class=\"rk-safety-item\">\n          <span class=\"rk-check\">✓</span>\n          <span>Check the label, expiry date, and storage instructions before use.</span>\n        </div>\n\n        <div class=\"rk-safety-item\">\n          <span class=\"rk-check\">✓</span>\n          <span>Do not share prescription medicines with other people.</span>\n        </div>\n\n        <div class=\"rk-safety-item\">\n          <span class=\"rk-check\">✓</span>\n          <span>Keep medicines out of the reach of children.</span>\n        </div>\n\n        <div class=\"rk-safety-item\">\n          <span class=\"rk-check\">✓</span>\n          <span>Seek professional advice if you experience unexpected side effects or are unsure how to use a medicine.</span>\n        </div>\n      </div>\n\n      <div class=\"rk-safety-copy\">\n        <span class=\"rk-eyebrow\">Care Comes First</span>\n        <h2>Make Informed Healthcare Decisions.</h2>\n        <p>\n          Every person's healthcare needs are different. Avoid self-diagnosis\n          and do not take prescription medicines without appropriate medical\n          advice. A qualified healthcare professional can help you understand\n          your options and determine when further medical attention is needed.\n        </p>\n        <a href=\"contact.html\" class=\"rk-btn\">Make an Enquiry</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- CONTACT CTA -->\n  <section class=\"rk-contact\">\n    <div class=\"rk-container rk-contact-inner\">\n      <div>\n        <h2>Looking for a Specific Product?</h2>\n        <p>Contact RegKings to enquire about availability before visiting.</p>\n      </div>\n      <a href=\"contact.html\" class=\"rk-btn\">Get in Touch →</a>\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"rk-footer\">\n    <div class=\"rk-container\">\n      <div class=\"rk-footer-inner\">\n        <div>\n          <a href=\"home.html\" class=\"rk-brand\">\n            RegKings\n            <span>PATENT &amp; COSMETIC STORES</span>\n          </a>\n          <p>Everyday care. Informed choices. Responsible service.</p>\n        </div>\n\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\n          <a href=\"home.html\">Home</a>\n          <a href=\"about.html\">About</a>\n          <a href=\"pharmacy.html\">Pharmacy</a>\n          <a href=\"patents.html\">Patent Medicines</a>\n          <a href=\"cosmetics.html\">Cosmetics</a>\n          <a href=\"products.html\">Products</a>\n          <a href=\"contact.html\">Contact</a>\n          <a href=\"visit.html\">Visit Us</a>\n        </nav>\n      </div>\n\n      <div class=\"rk-copyright\">\n        © <span id=\"rk-year\">2026</span> RegKings Patent &amp; Cosmetic Stores.\n        All rights reserved.\n      </div>\n    </div>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  var year = document.getElementById(\"rk-year\");\n\n  if (year) {\n    year.textContent = new Date().getFullYear();\n  }\n})();\n</script>",
          "_cid": "GG6BbHZWFp",
