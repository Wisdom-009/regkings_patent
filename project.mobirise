      "components": [
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n/* ==========================================\n   REGKINGS PATENT & COSMETIC STORES\n   Complete combined HTML website stylesheet\n   ========================================== */\n\n.regkings,\n.regkings * {\n  box-sizing: border-box;\n}\n\n.regkings {\n  --green: #00c896;\n  --green-dark: #008f70;\n  --navy: #061727;\n  --navy2: #0b2639;\n  --muted: #65788a;\n  --pale: #f1f8fa;\n  width: 100%;\n  overflow: hidden;\n  color: #14283c;\n  background: #ffffff;\n  font-family: Arial, Helvetica, sans-serif;\n}\n\n.regkings img {\n  display: block;\n  width: 100%;\n  max-width: 100%;\n  object-fit: cover;\n}\n\n.regkings a {\n  text-decoration: none !important;\n}\n\n.regkings .rk-wrap {\n  width: 92%;\n  max-width: 1240px;\n  margin: 0 auto;\n}\n\n.regkings .rk-eyebrow {\n  display: block;\n  margin-bottom: 12px;\n  color: var(--green-dark);\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 2px;\n  line-height: 1.7;\n}\n\n.regkings .rk-btn {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  gap: 8px;\n  padding: 13px 22px;\n  border: 1px solid var(--green);\n  border-radius: 30px;\n  background: var(--green);\n  color: #05251d !important;\n  font-size: 14px;\n  font-weight: 700;\n  line-height: 1.4;\n  cursor: pointer;\n  transition: all 0.25s ease;\n}\n\n.regkings .rk-btn:hover {\n  background: #00e0a8;\n  border-color: #00e0a8;\n  transform: translateY(-2px);\n  box-shadow: 0 8px 22px rgba(0, 200, 150, 0.2);\n}\n\n.regkings .rk-btn-outline {\n  color: #ffffff !important;\n  background: transparent;\n  border-color: rgba(0, 200, 150, 0.65);\n}\n\n.regkings .rk-btn-outline:hover {\n  color: var(--navy) !important;\n}\n\n/* HEADER */\n\n.regkings .rk-header {\n  position: relative;\n  z-index: 99;\n  background: #041321;\n  border-bottom: 1px solid rgba(0, 200, 150, 0.25);\n}\n\n.regkings .rk-nav {\n  min-height: 82px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.regkings .rk-brand {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n  color: #ffffff !important;\n  flex-shrink: 0;\n}\n\n.regkings .rk-brand-mark {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  width: 46px;\n  height: 46px;\n  border: 2px solid var(--green);\n  border-radius: 14px 14px 14px 4px;\n  color: var(--green);\n  font-size: 28px;\n  font-weight: 800;\n}\n\n.regkings .rk-brand-name {\n  display: block;\n  color: #ffffff;\n  font-size: 25px;\n  font-weight: 800;\n  line-height: 1.1;\n}\n\n.regkings .rk-brand-name span {\n  color: var(--green);\n}\n\n.regkings .rk-brand-sub {\n  display: block;\n  margin-top: 4px;\n  color: #d0dce5;\n  font-size: 10px;\n}\n\n.regkings .rk-menu {\n  display: flex;\n  align-items: center;\n  justify-content: flex-end;\n  gap: 5px;\n}\n\n.regkings .rk-menu a.rk-navlink {\n  display: inline-block;\n  padding: 12px 9px;\n  color: #edf4f8 !important;\n  font-size: 13px;\n  font-weight: 600;\n  transition: color 0.2s ease;\n}\n\n.regkings .rk-menu a.rk-navlink:hover,\n.regkings .rk-menu a.rk-navlink:focus {\n  color: var(--green) !important;\n}\n\n.regkings .rk-menu .rk-btn {\n  margin-left: 6px;\n  white-space: nowrap;\n}\n\n.regkings .rk-mobile-toggle {\n  display: none;\n  width: 43px;\n  height: 43px;\n  align-items: center;\n  justify-content: center;\n  color: var(--green);\n  background: transparent;\n  border: 1px solid rgba(0, 200, 150, 0.6);\n  border-radius: 8px;\n  font-size: 25px;\n  cursor: pointer;\n}\n\n/* HERO */\n\n.regkings .rk-hero {\n  color: #ffffff;\n  padding: 62px 0;\n  background:\n    radial-gradient(circle at 85% 30%, rgba(0, 200, 150, 0.12), transparent 34%),\n    linear-gradient(120deg, #061727, #0b2639);\n}\n\n.regkings .rk-hero-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 48px;\n  align-items: center;\n}\n\n.regkings .rk-hero .rk-eyebrow,\n.regkings .rk-products .rk-eyebrow,\n.regkings .rk-promise .rk-eyebrow {\n  color: #62f4d0;\n}\n\n.regkings .rk-hero h1 {\n  margin: 14px 0;\n  color: #ffffff;\n  font-size: clamp(36px, 4.5vw, 59px);\n  font-weight: 800;\n  line-height: 1.12;\n  letter-spacing: -1.5px;\n}\n\n.regkings .rk-hero h1 span {\n  color: var(--green);\n}\n\n.regkings .rk-hero-copy {\n  max-width: 520px;\n  color: #d0dce6;\n  font-size: 16px;\n  line-height: 1.8;\n}\n\n.regkings .rk-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 12px;\n  margin-top: 25px;\n}\n\n.regkings .rk-trust-note {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 10px;\n  margin-top: 26px;\n  color: #d1dfe8;\n  font-size: 12px;\n}\n\n.regkings .rk-trust-note span {\n  color: var(--green);\n  font-weight: bold;\n}\n\n.regkings .rk-hero-image {\n  position: relative;\n}\n\n.regkings .rk-hero-image > img {\n  height: 390px;\n  border: 1px solid rgba(0, 200, 150, 0.33);\n  border-radius: 18px;\n  box-shadow: 0 25px 60px rgba(0, 0, 0, 0.25);\n}\n\n.regkings .rk-image-label {\n  position: absolute;\n  bottom: 16px;\n  left: 16px;\n  right: 16px;\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 16px;\n  color: #ffffff;\n  background: rgba(4, 19, 33, 0.92);\n  border: 1px solid rgba(0, 200, 150, 0.4);\n  border-radius: 12px;\n}\n\n.regkings .rk-image-label .rk-spark {\n  color: var(--green);\n  font-size: 28px;\n}\n\n.regkings .rk-image-label strong,\n.regkings .rk-image-label small {\n  display: block;\n}\n\n.regkings .rk-image-label small {\n  margin-top: 4px;\n  color: #c3d4df;\n}\n\n/* BENEFITS */\n\n.regkings .rk-benefits {\n  padding: 25px 0;\n  border-bottom: 1px solid #e5edf1;\n  background: #ffffff;\n}\n\n.regkings .rk-benefit-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 16px;\n}\n\n.regkings .rk-benefit {\n  display: flex;\n  align-items: center;\n  gap: 12px;\n  padding: 10px;\n  border-right: 1px solid #e5edf1;\n}\n\n.regkings .rk-benefit:last-child {\n  border-right: 0;\n}\n\n.regkings .rk-benefit-icon {\n  color: var(--green-dark);\n  font-size: 30px;\n}\n\n.regkings .rk-benefit strong,\n.regkings .rk-benefit small {\n  display: block;\n}\n\n.regkings .rk-benefit strong {\n  margin-bottom: 5px;\n  font-size: 13px;\n}\n\n.regkings .rk-benefit small {\n  color: var(--muted);\n  font-size: 11px;\n  line-height: 1.5;\n}\n\n/* SERVICES */\n\n.regkings .rk-services {\n  padding: 78px 0;\n  background: var(--pale);\n}\n\n.regkings .rk-heading {\n  max-width: 650px;\n  margin-bottom: 32px;\n}\n\n.regkings .rk-heading h2,\n.regkings .rk-products h2,\n.regkings .rk-contact h2 {\n  margin: 10px 0;\n  color: var(--navy);\n  font-size: clamp(29px, 3.5vw, 42px);\n  line-height: 1.2;\n  font-weight: 800;\n  letter-spacing: -0.7px;\n}\n\n.regkings .rk-heading h2 span,\n.regkings .rk-contact h2 span {\n  color: var(--green-dark);\n}\n\n.regkings .rk-heading > p {\n  color: #586d81;\n  font-size: 15px;\n  line-height: 1.8;\n}\n\n.regkings .rk-service-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 22px;\n}\n\n.regkings .rk-service-card {\n  overflow: hidden;\n  background: #ffffff;\n  border: 1px solid #e2ebef;\n  border-radius: 14px;\n  box-shadow: 0 8px 30px rgba(6, 23, 39, 0.04);\n  transition: transform 0.25s ease, box-shadow 0.25s ease;\n}\n\n.regkings .rk-service-card:hover {\n  transform: translateY(-5px);\n  box-shadow: 0 15px 35px rgba(6, 23, 39, 0.1);\n}\n\n.regkings .rk-service-card > img {\n  height: 205px;\n}\n\n.regkings .rk-card-content {\n  padding: 23px;\n}\n\n.regkings .rk-card-icon {\n  display: inline-flex;\n  align-items: center;\n  justify-content: center;\n  width: 40px;\n  height: 40px;\n  margin-bottom: 10px;\n  border-radius: 10px;\n  background: #e1fbf3;\n  color: var(--green-dark);\n  font-size: 24px;\n}\n\n.regkings .rk-card-content h3 {\n  margin: 4px 0 10px;\n  color: var(--navy);\n  font-size: 21px;\n  font-weight: 700;\n}\n\n.regkings .rk-card-content p {\n  min-height: 65px;\n  color: #607489;\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n.regkings .rk-text-link,\n.regkings .rk-product-link {\n  color: var(--green-dark) !important;\n  font-size: 13px;\n  font-weight: 800;\n}\n\n/* PRODUCTS */\n\n.regkings .rk-products {\n  padding: 78px 0;\n  color: #ffffff;\n  background: var(--navy);\n}\n\n.regkings .rk-products-head {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n  margin-bottom: 30px;\n}\n\n.regkings .rk-products h2 {\n  color: #ffffff;\n}\n\n.regkings .rk-products h2 span {\n  color: var(--green);\n}\n\n.regkings .rk-products-head p {\n  color: #bdccd6;\n  font-size: 14px;\n  line-height: 1.7;\n}\n\n.regkings .rk-product-grid {\n  display: grid;\n  grid-template-columns: repeat(4, minmax(0, 1fr));\n  gap: 18px;\n}\n\n.regkings .rk-product-card {\n  overflow: hidden;\n  border: 1px solid #dfe8ec;\n  border-radius: 12px;\n  background: #ffffff;\n  transition: transform 0.25s ease;\n}\n\n.regkings .rk-product-card:hover {\n  transform: translateY(-5px);\n}\n\n.regkings .rk-product-card > img {\n  height: 185px;\n  background: #f1f6f8;\n}\n\n.regkings .rk-product-info {\n  padding: 17px;\n}\n\n.regkings .rk-product-category {\n  color: var(--green-dark);\n  font-size: 9px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.regkings .rk-product-info h3 {\n  margin: 8px 0;\n  color: var(--navy);\n  font-size: 17px;\n}\n\n.regkings .rk-product-info p {\n  min-height: 40px;\n  color: #63768a;\n  font-size: 12px;\n  line-height: 1.6;\n}\n\n/* BRAND PROMISE */\n\n.regkings .rk-promise {\n  padding: 68px 0;\n  color: #ffffff;\n  background:\n    radial-gradient(circle at 90% 30%, rgba(0, 200, 150, 0.12), transparent 35%),\n    #0a2235;\n}\n\n.regkings .rk-promise-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 45px;\n  align-items: center;\n}\n\n.regkings .rk-promise h2 {\n  margin: 10px 0 0;\n  color: #ffffff;\n  font-size: clamp(32px, 4vw, 46px);\n  line-height: 1.2;\n  font-weight: 800;\n}\n\n.regkings .rk-promise h2 span {\n  color: var(--green);\n}\n\n.regkings .rk-promise-copy p {\n  color: #cedbe4;\n  font-size: 15px;\n  line-height: 1.9;\n  margin-bottom: 22px;\n}\n\n/* CONTACT */\n\n.regkings .rk-contact {\n  padding: 78px 0;\n  background: #ffffff;\n}\n\n.regkings .rk-contact-grid {\n  display: grid;\n  grid-template-columns: 1fr 0.85fr;\n  gap: 55px;\n  align-items: start;\n}\n\n.regkings .rk-contact-intro {\n  color: #586d81;\n  font-size: 15px;\n  line-height: 1.8;\n}\n\n.regkings .rk-contact-detail {\n  display: flex;\n  align-items: flex-start;\n  gap: 15px;\n  margin-top: 24px;\n}\n\n.regkings .rk-contact-icon {\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  flex-shrink: 0;\n  width: 43px;\n  height: 43px;\n  color: var(--green-dark);\n  background: #e1fbf3;\n  border-radius: 10px;\n  font-size: 22px;\n}\n\n.regkings .rk-contact-detail strong {\n  display: block;\n  margin: 3px 0 5px;\n  color: var(--navy);\n}\n\n.regkings .rk-contact-detail p {\n  margin: 0;\n  color: #63768a;\n  font-size: 14px;\n  line-height: 1.7;\n  overflow-wrap: anywhere;\n}\n\n.regkings .rk-contact-detail a {\n  color: var(--green-dark) !important;\n  overflow-wrap: anywhere;\n}\n\n.regkings .rk-contact-detail a:hover {\n  text-decoration: underline !important;\n}\n\n.regkings .rk-contact-card {\n  padding: 32px;\n  border: 1px solid #dce9e9;\n  border-radius: 16px;\n  background: #f3faf8;\n}\n\n.regkings .rk-contact-card h3 {\n  margin: 12px 0;\n  color: var(--navy);\n  font-size: 26px;\n  font-weight: 800;\n}\n\n.regkings .rk-contact-card p {\n  color: #5d7183;\n  font-size: 14px;\n  line-height: 1.8;\n  margin-bottom: 22px;\n}\n\n.regkings .rk-contact-card small {\n  display: block;\n  margin-top: 14px;\n  color: #63768a;\n  font-size: 11px;\n  line-height: 1.6;\n}\n\n/* FOOTER */\n\n.regkings .rk-footer {\n  color: #ffffff;\n  background: #041321;\n  border-top: 1px solid rgba(0, 200, 150, 0.25);\n}\n\n.regkings .rk-footer-top {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n  padding: 30px 0;\n}\n\n.regkings .rk-footer-tagline {\n  color: #c1d0dc;\n  font-size: 13px;\n}\n\n.regkings .rk-back-top {\n  color: var(--green) !important;\n  font-size: 13px;\n  font-weight: 700;\n}\n\n.regkings .rk-footer-bottom {\n  display: flex;\n  justify-content: space-between;\n  gap: 15px;\n  padding: 18px 0;\n  border-top: 1px solid rgba(255, 255, 255, 0.09);\n}\n\n.regkings .rk-footer-bottom p {\n  margin: 0;\n  color: #aabcc9;\n  font-size: 11px;\n  line-height: 1.7;\n}\n\n/* TABLET */\n\n@media (max-width: 1050px) {\n  .regkings .rk-nav {\n    flex-wrap: wrap;\n    padding: 14px 0;\n  }\n\n  .regkings .rk-menu {\n    gap: 0;\n  }\n\n  .regkings .rk-menu a.rk-navlink {\n    padding: 10px 7px;\n    font-size: 12px;\n  }\n\n  .regkings .rk-menu .rk-btn {\n    padding: 10px 12px;\n  }\n}\n\n/* MOBILE NAVIGATION */\n\n@media (max-width: 900px) {\n  .regkings .rk-nav {\n    position: relative;\n    min-height: 75px;\n  }\n\n  .regkings .rk-mobile-toggle {\n    display: flex;\n  }\n\n  .regkings .rk-menu {\n    display: none;\n    position: absolute;\n    top: 100%;\n    left: 0;\n    right: 0;\n    padding: 14px;\n    flex-direction: column;\n    align-items: stretch;\n    background: #041321;\n    border: 1px solid rgba(0, 200, 150, 0.35);\n    border-radius: 12px;\n    box-shadow: 0 15px 35px rgba(0, 0, 0, 0.3);\n  }\n\n  .regkings .rk-menu.rk-menu-open {\n    display: flex;\n  }\n\n  .regkings .rk-menu a.rk-navlink {\n    padding: 13px 12px;\n    font-size: 14px;\n  }\n\n  .regkings .rk-menu .rk-btn {\n    margin: 8px 0 0;\n  }\n\n  .regkings .rk-hero-grid {\n    grid-template-columns: 1fr;\n    gap: 30px;\n  }\n\n  .regkings .rk-hero-image > img {\n    height: 350px;\n  }\n\n  .regkings .rk-benefit-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n\n  .regkings .rk-service-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .regkings .rk-product-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n\n  .regkings .rk-contact-grid {\n    grid-template-columns: 1fr;\n    gap: 35px;\n  }\n}\n\n/* SMALL MOBILE SCREENS */\n\n@media (max-width: 575px) {\n  .regkings .rk-wrap {\n    width: 90%;\n  }\n\n  .regkings .rk-brand-name {\n    font-size: 23px;\n  }\n\n  .regkings .rk-brand-sub {\n    font-size: 9px;\n  }\n\n  .regkings .rk-hero {\n    padding: 45px 0;\n  }\n\n  .regkings .rk-hero h1 {\n    font-size: 37px;\n  }\n\n  .regkings .rk-hero-copy {\n    font-size: 14px;\n  }\n\n  .regkings .rk-actions {\n    flex-direction: column;\n    align-items: stretch;\n  }\n\n  .regkings .rk-hero-image > img {\n    height: 260px;\n  }\n\n  .regkings .rk-benefit-grid,\n  .regkings .rk-service-grid,\n  .regkings .rk-product-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .regkings .rk-benefit {\n    border-right: 0;\n    border-bottom: 1px solid #e5edf1;\n    padding: 12px 0;\n  }\n\n  .regkings .rk-benefit:last-child {\n    border-bottom: 0;\n  }\n\n  .regkings .rk-services,\n  .regkings .rk-products,\n  .regkings .rk-contact {\n    padding: 54px 0;\n  }\n\n  .regkings .rk-products-head {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .regkings .rk-promise-grid {\n    grid-template-columns: 1fr;\n    gap: 22px;\n  }\n\n  .regkings .rk-contact-card {\n    padding: 24px;\n  }\n\n  .regkings .rk-footer-top,\n  .regkings .rk-footer-bottom {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n}\n</style>\n\n<div class=\"regkings\" id=\"rk-home\">\n\n  <!-- HEADER -->\n  <header class=\"rk-header\">\n    <div class=\"rk-wrap rk-nav\">\n\n      <a class=\"rk-brand\" href=\"#rk-home\">\n        <span class=\"rk-brand-mark\">✚</span>\n        <span>\n          <span class=\"rk-brand-name\">Reg<span>Kings</span></span>\n          <span class=\"rk-brand-sub\">Patent &amp; Cosmetic Stores</span>\n        </span>\n      </a>\n\n      <button class=\"rk-mobile-toggle\" type=\"button\" aria-label=\"Toggle navigation\" aria-expanded=\"false\">\n        ☰\n      </button>\n\n      <nav class=\"rk-menu\">\n        <a class=\"rk-navlink\" href=\"home.html\">Home</a>\n        <a class=\"rk-navlink\" href=\"about.html\">About</a>\n        <a class=\"rk-navlink\" href=\"pharmacy.html\">Pharmacy</a>\n        <a class=\"rk-navlink\" href=\"patents.html\">Patents</a>\n        <a class=\"rk-navlink\" href=\"cosmetics.html\">Cosmetics</a>\n        <a class=\"rk-navlink\" href=\"products.html\">Products</a>\n        <a class=\"rk-navlink\" href=\"contact.html\">Contact</a>\n        <a class=\"rk-btn\" href=\"visit.html\">Visit Our Store →</a>\n      </nav>\n\n    </div>\n  </header>\n\n  <!-- HERO -->\n  <section data-bs-version=\"5.1\" class=\"rk-hero\">\n    <div class=\"rk-wrap rk-hero-grid\">\n\n      <div>\n        <span class=\"rk-eyebrow\">YOUR HEALTH · OUR PRIORITY</span>\n\n        <h1>Effective Medicines,<br><span>Healthy Lives.</span></h1>\n\n        <p class=\"rk-hero-copy\">\n          Welcome to RegKings Patent &amp; Cosmetic Stores,\n          your destination for healthcare essentials, patent medicine\n          products, skincare and beauty items.\n        </p>\n\n        <div class=\"rk-actions\">\n          <a class=\"rk-btn\" href=\"#rk-products\">Explore Products →</a>\n          <a class=\"rk-btn rk-btn-outline\" href=\"#rk-about\">Learn More</a>\n        </div>\n\n        <div class=\"rk-trust-note\">\n          <span>✓</span> Quality-focused service\n          <span>✓</span> Health and beauty essentials\n        </div>\n      </div>\n\n      <div class=\"rk-hero-image\">\n        <img src=\"@PROJECT_PATH@/assets/images/grok-1792153568000-1108x744.jpeg\" alt=\"Healthcare professional\">\n        <div class=\"rk-image-label\">\n          <span class=\"rk-spark\">✦</span>\n          <div>\n            <strong>Health. Beauty. Wellness.</strong>\n            <small>Care you can count on.</small>\n          </div>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- BENEFITS -->\n  <section class=\"rk-benefits\">\n    <div class=\"rk-wrap rk-benefit-grid\">\n\n      <div class=\"rk-benefit\">\n        <span class=\"rk-benefit-icon\">✓</span>\n        <div>\n          <strong>Quality Products</strong>\n          <small>Products from trusted sources</small>\n        </div>\n      </div>\n\n      <div class=\"rk-benefit\">\n        <span class=\"rk-benefit-icon\">↗</span>\n        <div>\n          <strong>Friendly Service</strong>\n          <small>Helpful customer support</small>\n        </div>\n      </div>\n\n      <div class=\"rk-benefit\">\n        <span class=\"rk-benefit-icon\">✚</span>\n        <div>\n          <strong>Health Essentials</strong>\n          <small>Everyday healthcare needs</small>\n        </div>\n      </div>\n\n      <div class=\"rk-benefit\">\n        <span class=\"rk-benefit-icon\">♡</span>\n        <div>\n          <strong>Beauty &amp; Wellness</strong>\n          <small>Personal care essentials</small>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- SERVICES -->\n  <section class=\"rk-services\" id=\"rk-about\">\n    <div class=\"rk-wrap\">\n\n      <div class=\"rk-heading\">\n        <span class=\"rk-eyebrow\">WELCOME TO REGKINGS</span>\n        <h2>Everything You Need,<br><span>Under One Roof.</span></h2>\n        <p>\n          <br>Discover pharmacy essentials, patent medicine products and\n          personal care items in one convenient place.\n        </p>\n      </div>\n\n      <div class=\"rk-service-grid\">\n\n        <article class=\"rk-service-card\" id=\"rk-pharmacy\">\n          <img src=\"@PROJECT_PATH@/assets/images/grok-1792153105553-740x497.jpg\" alt=\"Pharmacy products\">\n          <div class=\"rk-card-content\">\n            <span class=\"rk-card-icon\">✚</span>\n            <h3>Pharmacy</h3>\n            <p>\n              Explore available medicines, healthcare essentials\n              and pharmacy products.\n            </p>\n            <a class=\"rk-text-link\" href=\"#rk-contact\">Enquire About Products →</a>\n          </div>\n        </article>\n\n        <article class=\"rk-service-card\" id=\"rk-patents\">\n          <img src=\"@PROJECT_PATH@/assets/images/drugs-740x457.jpg\" alt=\"Health products\">\n          <div class=\"rk-card-content\">\n            <span class=\"rk-card-icon\">＋</span>\n            <h3>Patent Medicines</h3>\n            <p>\n              Ask our team about product availability and appropriate\n              healthcare guidance.\n            </p>\n            <a class=\"rk-text-link\" href=\"#rk-contact\">Make an Enquiry →</a>\n          </div>\n        </article>\n\n        <article class=\"rk-service-card\" id=\"rk-cosmetics\">\n          <img src=\"@PROJECT_PATH@/assets/images/grok-1792153105553-740x497.jpg\" alt=\"Skincare and cosmetics\">\n          <div class=\"rk-card-content\">\n            <span class=\"rk-card-icon\">✧</span>\n            <h3>Cosmetics &amp; Skincare</h3>\n            <p>\n              Explore skincare, haircare, beauty and personal care essentials.\n            </p>\n            <a class=\"rk-text-link\" href=\"#rk-contact\">Explore Beauty →</a>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- PRODUCTS -->\n  <section class=\"rk-products\" id=\"rk-products\">\n    <div class=\"rk-wrap\">\n\n      <div class=\"rk-products-head\">\n        <div>\n          <span class=\"rk-eyebrow\">OUR COLLECTION</span>\n          <h2>Featured <span>Products</span></h2>\n          <p>Ask us about available products and current stock.</p>\n        </div>\n        <a class=\"rk-btn rk-btn-outline\" href=\"#rk-contact\">\n          Ask About Products →\n        </a>\n      </div>\n\n      <div class=\"rk-product-grid\">\n\n        <article class=\"rk-product-card\">\n          <img src=\"https://images.unsplash.com/photo-1571781926291-c477ebfd024b?auto=format&fit=crop&w=600&q=80\" alt=\"Skincare products\">\n          <div class=\"rk-product-info\">\n            <span class=\"rk-product-category\">PERSONAL CARE</span>\n            <h3>Daily Skincare</h3>\n            <p>Ask about available skincare products.</p>\n            <a class=\"rk-product-link\" href=\"#rk-contact\">Enquire Now →</a>\n          </div>\n        </article>\n\n        <article class=\"rk-product-card\">\n          <img src=\"https://images.unsplash.com/photo-1607619056574-7b8d3ee536b2?auto=format&fit=crop&w=600&q=80\" alt=\"Healthcare products\">\n          <div class=\"rk-product-info\">\n            <span class=\"rk-product-category\">HEALTH ESSENTIALS</span>\n            <h3>Health Products</h3>\n            <p>Ask about product availability.</p>\n            <a class=\"rk-product-link\" href=\"#rk-contact\">Enquire Now →</a>\n          </div>\n        </article>\n\n        <article class=\"rk-product-card\">\n          <img src=\"https://images.unsplash.com/photo-1556229010-6c3f2c9ca5f8?auto=format&fit=crop&w=600&q=80\" alt=\"Beauty products\">\n          <div class=\"rk-product-info\">\n            <span class=\"rk-product-category\">BEAUTY</span>\n            <h3>Beauty Essentials</h3>\n            <p>Discover cosmetics and beauty items.</p>\n            <a class=\"rk-product-link\" href=\"#rk-contact\">Enquire Now →</a>\n          </div>\n        </article>\n\n        <article class=\"rk-product-card\">\n          <img src=\"https://images.unsplash.com/photo-1608571423902-eed4a5ad8108?auto=format&fit=crop&w=600&q=80\" alt=\"Body care products\">\n          <div class=\"rk-product-info\">\n            <span class=\"rk-product-category\">BODY CARE</span>\n            <h3>Body &amp; Haircare</h3>\n            <p>Ask about available personal care products.</p>\n            <a class=\"rk-product-link\" href=\"#rk-contact\">Enquire Now →</a>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- BRAND PROMISE -->\n  <section class=\"rk-promise\">\n    <div class=\"rk-wrap rk-promise-grid\">\n\n      <div>\n        <span class=\"rk-eyebrow\">THE REGKINGS PROMISE</span>\n        <h2>Your Health and<br><span>Wellbeing Matter.</span></h2>\n      </div>\n\n      <div class=\"rk-promise-copy\">\n        <p>\n          At RegKings Patent &amp; Cosmetic Stores, we aim to make\n          healthcare essentials and personal care shopping convenient,\n          welcoming and dependable.\n        </p>\n        <a class=\"rk-btn\" href=\"#rk-contact\">Get in Touch →</a>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- CONTACT -->\n  <section class=\"rk-contact\" id=\"rk-contact\">\n    <div class=\"rk-wrap rk-contact-grid\">\n\n      <div>\n        <span class=\"rk-eyebrow\">WE'RE HERE TO HELP</span>\n        <h2>Visit or Contact <span>RegKings.</span></h2>\n\n        <p class=\"rk-contact-intro\">\n          Contact our team to ask about products, availability,\n          store hours or other enquiries.\n        </p>\n\n        <div class=\"rk-contact-detail\">\n          <span class=\"rk-contact-icon\">⌖</span>\n          <div>\n            <strong>Our Store</strong>\n            <p>\n              No. 1 Femi Daramola St., Off Odo-Olowu,\n              Ijeshatedo, Surulere, Lagos.\n            </p>\n            <p>\n              <a href=\"https://www.google.com/maps/search/?api=1&query=No.+1+Femi+Daramola+Street+Ijeshatedo+Surulere+Lagos\" target=\"_blank\" rel=\"noopener\" class=\"text-primary\">\n                Find us on Google Maps →\n              </a>\n            </p>\n          </div>\n        </div>\n\n        <div class=\"rk-contact-detail\">\n          <span class=\"rk-contact-icon\">☎</span>\n          <div>\n            <strong>Phone / WhatsApp</strong>\n            <p>\n              <a href=\"tel:+2348032914054\">08032914054</a>\n            </p>\n            <p>\n              <a href=\"https://wa.me/2348032914054\" target=\"_blank\" rel=\"noopener\">\n                Chat with us on WhatsApp →\n              </a>\n            </p>\n          </div>\n        </div>\n\n        <div class=\"rk-contact-detail\">\n          <span class=\"rk-contact-icon\">✉</span>\n          <div>\n            <strong>Email</strong>\n            <p>\n              <a href=\"mailto:reginaudehcaregiver@gmail.com\">\n                reginaudehcaregiver@gmail.com\n              </a>\n            </p>\n          </div>\n        </div>\n      </div>\n\n      <div class=\"rk-contact-card\">\n        <span class=\"rk-eyebrow\">REGKINGS PATENT &amp; COSMETIC STORES</span>\n        <h3>How can we help you?</h3>\n        <p>\n          Contact us with your product enquiry, and our team can help\n          you check availability and store details.\n        </p>\n\n        <a class=\"rk-btn\" href=\"mailto:reginaudehcaregiver@gmail.com?subject=RegKings%20Product%20Enquiry\">\n          Email Our Team →\n        </a>\n\n        <small>\n          This button opens your email app with the RegKings email address\n          and a product enquiry subject already filled in.\n        </small>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"rk-footer\">\n    <div class=\"rk-wrap rk-footer-top\">\n\n      <a class=\"rk-brand\" href=\"#rk-home\">\n        <span class=\"rk-brand-mark\">✚</span>\n        <span>\n          <span class=\"rk-brand-name\">Reg<span>Kings</span></span>\n          <span class=\"rk-brand-sub\">Patent &amp; Cosmetic Stores</span>\n        </span>\n      </a>\n\n      <p class=\"rk-footer-tagline\">\n        Health · Beauty · Everyday Essentials\n      </p>\n\n      <a class=\"rk-back-top\" href=\"#rk-home\">Back to top ↑</a>\n\n    </div>\n\n    <div class=\"rk-wrap rk-footer-bottom\">\n      <p>\n        © <span class=\"rk-year\">2026</span>\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\n      </p>\n      <p>\n        Product availability and prices should be confirmed with the store.\n      </p>\n    </div>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  var root = document.getElementById(\"rk-home\");\n  if (!root) return;\n\n  var year = root.querySelector(\".rk-year\");\n  if (year) {\n    year.textContent = new Date().getFullYear();\n  }\n\n  var menu = root.querySelector(\".rk-menu\");\n  var toggle = root.querySelector(\".rk-mobile-toggle\");\n\n  if (menu && toggle) {\n    toggle.addEventListener(\"click\", function () {\n      var isOpen = menu.classList.toggle(\"rk-menu-open\");\n      toggle.setAttribute(\"aria-expanded\", isOpen ? \"true\" : \"false\");\n      toggle.innerHTML = isOpen ? \"&times;\" : \"&#9776;\";\n    });\n\n    menu.querySelectorAll(\"a\").forEach(function (link) {\n      link.addEventListener(\"click\", function () {\n        menu.classList.remove(\"rk-menu-open\");\n        toggle.setAttribute(\"aria-expanded\", \"false\");\n        toggle.innerHTML = \"&#9776;\";\n      });\n    });\n  }\n})();\n</script>",
          "_cid": "vyvvEYqkMA",
          "_anchor": "header09-3",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "patents.html": {
      "settings": {
        "title": "patents",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "3"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "P": {
              "color": "#9fe870"
            }
          },
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n/* REGKINGS PATENT MEDICINES PAGE */\n.regkings {\n  --rk-navy: #071b2b;\n  --rk-green: #20c878;\n  --rk-white: #ffffff;\n  --rk-muted: #b8c7d0;\n  font-family: Arial, Helvetica, sans-serif;\n  color: var(--rk-white);\n  background: var(--rk-navy);\n  line-height: 1.7;\n  overflow: hidden;\n}\n\n.regkings * {\n  box-sizing: border-box;\n}\n\n.regkings a {\n  text-decoration: none;\n}\n\n.regkings .rk-container {\n  width: 92%;\n  max-width: 1180px;\n  margin: auto;\n}\n\n/* HEADER */\n.regkings .rk-nav {\n  background: #061522;\n  border-bottom: 1px solid rgba(255,255,255,.08);\n  position: relative;\n  z-index: 10;\n}\n\n.regkings .rk-nav-inner {\n  min-height: 82px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.regkings .rk-brand {\n  color: #fff;\n  font-size: 21px;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.regkings .rk-brand span {\n  display: block;\n  color: var(--rk-green);\n  font-size: 11px;\n  letter-spacing: 1.8px;\n  margin-top: 5px;\n}\n\n.regkings .rk-menu {\n  display: flex;\n  align-items: center;\n  gap: 17px;\n}\n\n.regkings .rk-menu a {\n  color: #d8e2e8;\n  font-size: 13px;\n  transition: color .2s ease;\n}\n\n.regkings .rk-menu a:hover,\n.regkings .rk-menu a.rk-active {\n  color: var(--rk-green);\n}\n\n.regkings .rk-menu-btn {\n  display: none;\n  border: 1px solid #415566;\n  border-radius: 5px;\n  padding: 7px 12px;\n  color: #fff;\n  background: transparent;\n  font-size: 22px;\n  cursor: pointer;\n}\n\n/* PAGE INTRODUCTION */\n.regkings .rk-page-intro {\n  padding: 66px 0 60px;\n  background: #0a2334;\n  border-bottom: 3px solid var(--rk-green);\n}\n\n.regkings .rk-breadcrumb {\n  font-size: 12px;\n  color: #a9bac5;\n  margin-bottom: 22px;\n}\n\n.regkings .rk-breadcrumb a {\n  color: var(--rk-green);\n}\n\n.regkings .rk-intro-grid {\n  display: grid;\n  grid-template-columns: 1.4fr .6fr;\n  align-items: center;\n  gap: 50px;\n}\n\n.regkings .rk-eyebrow {\n  color: var(--rk-green);\n  font-size: 12px;\n  text-transform: uppercase;\n  font-weight: 700;\n  letter-spacing: 2px;\n}\n\n.regkings .rk-page-intro h1 {\n  color: #fff;\n  font-size: clamp(34px, 4.5vw, 53px);\n  line-height: 1.15;\n  margin: 13px 0 18px;\n}\n\n.regkings .rk-page-intro p {\n  color: var(--rk-muted);\n  max-width: 650px;\n  margin: 0 0 23px;\n}\n\n.regkings .rk-intro-mark {\n  border-left: 3px solid var(--rk-green);\n  padding: 10px 0 10px 25px;\n}\n\n.regkings .rk-intro-mark strong {\n  display: block;\n  font-size: 22px;\n  color: #fff;\n  line-height: 1.35;\n  margin-bottom: 10px;\n}\n\n.regkings .rk-intro-mark span {\n  color: var(--rk-muted);\n  font-size: 14px;\n}\n\n/* BUTTONS */\n.regkings .rk-btn {\n  display: inline-block;\n  background: var(--rk-green);\n  color: #062033;\n  padding: 12px 21px;\n  border-radius: 4px;\n  font-size: 14px;\n  font-weight: 700;\n  transition: background .2s ease;\n}\n\n.regkings .rk-btn:hover {\n  background: #47df96;\n}\n\n.regkings .rk-outline-btn {\n  display: inline-block;\n  border: 1px solid #718592;\n  color: #fff;\n  padding: 11px 20px;\n  border-radius: 4px;\n  margin-left: 9px;\n  font-size: 14px;\n}\n\n.regkings .rk-outline-btn:hover {\n  border-color: var(--rk-green);\n  color: var(--rk-green);\n}\n\n/* PRODUCT CATEGORIES */\n.regkings .rk-section {\n  padding: 68px 0;\n}\n\n.regkings .rk-section-light {\n  background: #f5f7f6;\n  color: #172e3a;\n}\n\n.regkings .rk-section-heading {\n  max-width: 740px;\n  margin-bottom: 35px;\n}\n\n.regkings .rk-section-heading h2 {\n  color: inherit;\n  font-size: clamp(27px, 3.5vw, 36px);\n  line-height: 1.25;\n  margin: 9px 0 12px;\n}\n\n.regkings .rk-section-heading p {\n  color: #697982;\n  margin: 0;\n}\n\n.regkings .rk-product-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 0 28px;\n}\n\n.regkings .rk-product {\n  padding: 25px 0;\n  border-top: 1px solid #d9e2de;\n}\n\n.regkings .rk-product-number {\n  color: #14834e;\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 1px;\n}\n\n.regkings .rk-product h3 {\n  color: #102b3b;\n  font-size: 19px;\n  margin: 7px 0;\n}\n\n.regkings .rk-product p {\n  color: #667781;\n  font-size: 14px;\n  margin: 0;\n}\n\n/* RESPONSIBLE USE */\n.regkings .rk-guidance {\n  padding: 65px 0;\n  background: #0c293a;\n}\n\n.regkings .rk-guidance-grid {\n  display: grid;\n  grid-template-columns: .85fr 1.15fr;\n  gap: 55px;\n  align-items: start;\n}\n\n.regkings .rk-guidance h2 {\n  color: #fff;\n  font-size: clamp(27px, 3.5vw, 36px);\n  line-height: 1.25;\n  margin: 10px 0 16px;\n}\n\n.regkings .rk-guidance p {\n  color: var(--rk-muted);\n  font-size: 14px;\n}\n\n.regkings .rk-guidance-list {\n  border-top: 1px solid #365064;\n}\n\n.regkings .rk-guidance-item {\n  display: flex;\n  gap: 16px;\n  padding: 17px 0;\n  border-bottom: 1px solid #365064;\n}\n\n.regkings .rk-guidance-item strong {\n  color: var(--rk-green);\n  font-size: 14px;\n  min-width: 25px;\n}\n\n.regkings .rk-guidance-item p {\n  color: #d3dfe5;\n  margin: 0;\n}\n\n/* ENQUIRY BANNER */\n.regkings .rk-enquiry {\n  padding: 48px 0;\n  background: #eaf5ee;\n  color: #122d3a;\n}\n\n.regkings .rk-enquiry-inner {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 25px;\n}\n\n.regkings .rk-enquiry h2 {\n  font-size: clamp(23px, 3vw, 31px);\n  margin: 0 0 7px;\n  line-height: 1.3;\n}\n\n.regkings .rk-enquiry p {\n  color: #60736b;\n  margin: 0;\n}\n\n.regkings .rk-enquiry .rk-btn {\n  flex-shrink: 0;\n}\n\n/* FOOTER */\n.regkings .rk-footer {\n  padding: 32px 0 18px;\n  background: #04121d;\n}\n\n.regkings .rk-footer-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 25px;\n}\n\n.regkings .rk-footer p {\n  color: #96a9b4;\n  font-size: 13px;\n  margin: 9px 0;\n}\n\n.regkings .rk-footer-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.regkings .rk-footer-links a {\n  color: #c8d5dc;\n  font-size: 13px;\n}\n\n.regkings .rk-footer-links a:hover {\n  color: var(--rk-green);\n}\n\n.regkings .rk-copyright {\n  margin-top: 23px;\n  padding-top: 16px;\n  border-top: 1px solid rgba(255,255,255,.09);\n  color: #8297a3;\n  font-size: 12px;\n}\n\n/* MOBILE MENU AND LAYOUT */\n@media (max-width: 1000px) {\n  .regkings .rk-menu {\n    gap: 10px;\n  }\n\n  .regkings .rk-menu a {\n    font-size: 12px;\n  }\n\n  .regkings .rk-product-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 760px) {\n  .regkings .rk-nav-inner {\n    flex-wrap: wrap;\n    padding: 14px 0;\n  }\n\n  .regkings .rk-menu-btn {\n    display: block;\n  }\n\n  .regkings .rk-menu {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 0;\n  }\n\n  .regkings .rk-menu.rk-menu-open {\n    display: flex;\n  }\n\n  .regkings .rk-menu a {\n    padding: 10px 2px;\n    border-top: 1px solid rgba(255,255,255,.07);\n    font-size: 14px;\n  }\n\n  .regkings .rk-page-intro {\n    padding: 45px 0;\n  }\n\n  .regkings .rk-intro-grid,\n  .regkings .rk-guidance-grid {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n\n  .regkings .rk-intro-mark {\n    margin-top: 5px;\n  }\n\n  .regkings .rk-section {\n    padding: 48px 0;\n  }\n\n  .regkings .rk-product-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .regkings .rk-enquiry-inner {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .regkings .rk-outline-btn {\n    margin: 12px 0 0;\n  }\n}\n</style>\n\n<div class=\"regkings\">\n\n  <!-- HEADER -->\n  <header class=\"rk-nav\">\n    <div class=\"rk-container rk-nav-inner\">\n\n      <a href=\"home.html\" class=\"rk-brand\">\n        RegKings\n        <span>PATENT &amp; COSMETIC STORES</span>\n      </a>\n\n      <button class=\"rk-menu-btn\" type=\"button\" aria-label=\"Toggle navigation\" aria-expanded=\"false\" onclick=\"(function(b){var m=b.parentElement.querySelector('.rk-menu');var o=m.classList.toggle('rk-menu-open');b.setAttribute('aria-expanded',o?'true':'false');})(this)\">\n        ☰\n      </button>\n\n      <nav class=\"rk-menu\" aria-label=\"Main navigation\">\n        <a href=\"home.html\">Home</a>\n        <a href=\"about.html\">About</a>\n        <a href=\"pharmacy.html\">Pharmacy</a>\n        <a href=\"patents.html\" class=\"rk-active\">Patent Medicines</a>\n        <a href=\"cosmetics.html\">Cosmetics</a>\n        <a href=\"contact.html\">Contact</a>\n        <a href=\"visit.html\">Visit Us</a>\n      </nav>\n\n    </div>\n  </header>\n\n  <!-- PAGE INTRODUCTION -->\n  <section data-bs-version=\"5.1\" class=\"rk-page-intro\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-breadcrumb\">\n        <a href=\"home.html\">Home</a> &nbsp;/&nbsp; Patent Medicines\n      </div>\n\n      <div class=\"rk-intro-grid\">\n        <div>\n          <span class=\"rk-eyebrow\">RegKings · Patent Medicines</span>\n\n          <h1>Everyday Healthcare, With Care and Responsibility.</h1>\n\n          <p>\n            Looking for a familiar healthcare product? Explore the categories\n            below and contact RegKings to enquire about availability. We\n            encourage informed choices and the responsible use of medicines.\n          </p>\n\n          <a href=\"contact.html\" class=\"rk-btn\">Enquire About a Product</a>\n          <a href=\"pharmacy.html\" class=\"rk-outline-btn\">View Categories</a>\n        </div>\n\n        <div class=\"rk-intro-mark\">\n          <strong>Choose carefully. Use medicines responsibly.</strong>\n          <span>\n            Read product labels and seek advice from an appropriately\n            qualified healthcare professional whenever necessary.\n          </span>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- PRODUCT RANGE -->\n  <section class=\"rk-section rk-section-light\" id=\"rk-range\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-section-heading\">\n        <span class=\"rk-eyebrow\">Product Categories</span>\n        <h2>Explore Our Patent Medicine Categories</h2>\n        <p>\n          The categories below are provided to help customers make enquiries.\n          Actual stock and the range of products available should be confirmed\n          directly with the store.\n        </p>\n      </div>\n\n      <div class=\"rk-product-grid\">\n\n        <article class=\"rk-product\">\n          <span class=\"rk-product-number\">01 / HEALTH</span>\n          <h3>Everyday Healthcare</h3>\n          <p>\n            Enquire about commonly requested healthcare products and follow\n            the instructions supplied with each product.\n          </p>\n        </article>\n\n        <article class=\"rk-product\">\n          <span class=\"rk-product-number\">02 / RELIEF</span>\n          <h3>Pain and Fever Relief</h3>\n          <p>\n            Ask about suitable products and their precautions. Check age\n            restrictions, dosage directions, and warnings before use.\n          </p>\n        </article>\n\n        <article class=\"rk-product\">\n          <span class=\"rk-product-number\">03 / COLD CARE</span>\n          <h3>Cold and Cough Products</h3>\n          <p>\n            Enquire about available products and seek professional advice\n            when symptoms are severe, persistent, or concerning.\n          </p>\n        </article>\n\n        <article class=\"rk-product\">\n          <span class=\"rk-product-number\">04 / FIRST AID</span>\n          <h3>First-Aid Supplies</h3>\n          <p>\n            Ask about basic first-aid items and wound-care supplies that\n            may be available at the store.\n          </p>\n        </article>\n\n        <article class=\"rk-product\">\n          <span class=\"rk-product-number\">05 / DIGESTIVE CARE</span>\n          <h3>Digestive Health Products</h3>\n          <p>\n            Enquire about products for common digestive concerns and obtain\n            appropriate advice before selecting a treatment.\n          </p>\n        </article>\n\n        <article class=\"rk-product\">\n          <span class=\"rk-product-number\">06 / PERSONAL CARE</span>\n          <h3>Personal Care Essentials</h3>\n          <p>\n            Explore everyday personal-care and hygiene essentials. Contact\n            the store to confirm the current range.\n          </p>\n        </article>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- RESPONSIBLE USE -->\n  <section class=\"rk-guidance\">\n    <div class=\"rk-container rk-guidance-grid\">\n\n      <div>\n        <span class=\"rk-eyebrow\">Customer Information</span>\n        <h2>Medicine Safety Should Always Come First.</h2>\n        <p>\n          Medicines can have side effects and may interact with other\n          medicines or existing health conditions. If you are unsure whether\n          a product is appropriate for you, consult a qualified healthcare\n          professional.\n        </p>\n      </div>\n\n      <div class=\"rk-guidance-list\">\n\n        <div class=\"rk-guidance-item\">\n          <strong>01</strong>\n          <p>\n            <b>Read the label.</b> Follow the stated directions, warnings,\n            storage instructions, and expiry information.\n          </p>\n        </div>\n\n        <div class=\"rk-guidance-item\">\n          <strong>02</strong>\n          <p>\n            <b>Use the correct product.</b> Do not assume a medicine is\n            suitable simply because it helped someone else.\n          </p>\n        </div>\n\n        <div class=\"rk-guidance-item\">\n          <strong>03</strong>\n          <p>\n            <b>Ask before combining medicines.</b> A healthcare professional\n            can help identify potential interactions and precautions.\n          </p>\n        </div>\n\n        <div class=\"rk-guidance-item\">\n          <strong>04</strong>\n          <p>\n            <b>Know when to seek medical care.</b> Serious or worsening\n            symptoms require appropriate medical assessment.\n          </p>\n        </div>\n\n      </div>\n\n    </div>\n  </section>\n\n  <!-- PRODUCT ENQUIRY -->\n  <section class=\"rk-enquiry\">\n    <div class=\"rk-container rk-enquiry-inner\">\n\n      <div>\n        <h2>Looking for a Particular Product?</h2>\n        <p>\n          Contact RegKings to ask whether the product is available before\n          visiting the store.\n        </p>\n      </div>\n\n      <a href=\"contact.html\" class=\"rk-btn\">Contact RegKings →</a>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"rk-footer\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-footer-top\">\n        <div>\n          <a href=\"home.html\" class=\"rk-brand\">\n            RegKings\n            <span>PATENT &amp; COSMETIC STORES</span>\n          </a>\n          <p>Everyday care. Informed choices. Responsible service.</p>\n        </div>\n\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\n          <a href=\"home.html\">Home</a>\n          <a href=\"about.html\">About</a>\n          <a href=\"pharmacy.html\">Pharmacy</a>\n          <a href=\"patents.html\">Patent Medicines</a>\n          <a href=\"cosmetics.html\">Cosmetics</a>\n          <a href=\"contact.html\">Contact</a>\n          <a href=\"visit.html\">Visit Us</a>\n        </nav>\n      </div>\n\n      <div class=\"rk-copyright\">\n        © <span id=\"rk-year\">2026</span>\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\n      </div>\n\n    </div>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  var year = document.getElementById(\"rk-year\");\n\n  if (year) {\n    year.textContent = new Date().getFullYear();\n  }\n})();\n</script>",
