    },
    "contact.html": {
      "settings": {
        "title": "contact",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "5"
      },
      "components": [
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n/* REGKINGS CONTACT PAGE */\n.regkings {\n  --rk-navy: #071b2b;\n  --rk-green: #20c878;\n  --rk-white: #ffffff;\n  --rk-muted: #b8c7d0;\n  font-family: Arial, Helvetica, sans-serif;\n  color: var(--rk-white);\n  background: var(--rk-navy);\n  line-height: 1.7;\n  overflow: hidden;\n}\n\n.regkings * {\n  box-sizing: border-box;\n}\n\n.regkings a {\n  text-decoration: none;\n}\n\n.regkings .rk-container {\n  width: 92%;\n  max-width: 1180px;\n  margin: auto;\n}\n\n/* HEADER */\n.regkings .rk-nav {\n  background: #061522;\n  border-bottom: 1px solid rgba(255,255,255,.08);\n  position: relative;\n  z-index: 10;\n}\n\n.regkings .rk-nav-inner {\n  min-height: 82px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.regkings .rk-brand {\n  color: #fff;\n  font-size: 21px;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.regkings .rk-brand span {\n  display: block;\n  color: var(--rk-green);\n  font-size: 11px;\n  letter-spacing: 1.8px;\n  margin-top: 5px;\n}\n\n.regkings .rk-menu {\n  display: flex;\n  align-items: center;\n  gap: 17px;\n}\n\n.regkings .rk-menu a {\n  color: #d8e2e8;\n  font-size: 13px;\n  transition: color .2s ease;\n}\n\n.regkings .rk-menu a:hover,\n.regkings .rk-menu a.rk-active {\n  color: var(--rk-green);\n}\n\n.regkings .rk-menu-btn {\n  display: none;\n  border: 1px solid #415566;\n  border-radius: 5px;\n  padding: 7px 12px;\n  color: #fff;\n  background: transparent;\n  font-size: 22px;\n  cursor: pointer;\n}\n\n/* PAGE INTRO */\n.regkings .rk-intro {\n  padding: 58px 0 55px;\n  background: #0a2334;\n  border-bottom: 3px solid var(--rk-green);\n}\n\n.regkings .rk-eyebrow {\n  color: var(--rk-green);\n  font-size: 12px;\n  text-transform: uppercase;\n  font-weight: 700;\n  letter-spacing: 2px;\n}\n\n.regkings .rk-intro h1 {\n  font-size: clamp(35px, 4.5vw, 50px);\n  line-height: 1.15;\n  color: #fff;\n  margin: 12px 0 15px;\n}\n\n.regkings .rk-intro p {\n  color: var(--rk-muted);\n  max-width: 690px;\n  margin: 0;\n}\n\n.regkings .rk-breadcrumb {\n  color: #a9bac5;\n  font-size: 12px;\n  margin-bottom: 22px;\n}\n\n.regkings .rk-breadcrumb a {\n  color: var(--rk-green);\n}\n\n/* MAIN LAYOUT */\n.regkings .rk-contact-section {\n  padding: 65px 0;\n  background: #f5f7f6;\n  color: #172e3a;\n}\n\n.regkings .rk-contact-grid {\n  display: grid;\n  grid-template-columns: .8fr 1.2fr;\n  gap: 45px;\n  align-items: start;\n}\n\n/* CONTACT INFORMATION */\n.regkings .rk-contact-info h2 {\n  font-size: 29px;\n  line-height: 1.3;\n  margin: 9px 0 13px;\n  color: #102b3b;\n}\n\n.regkings .rk-contact-info > p {\n  color: #687982;\n  font-size: 14px;\n  margin-bottom: 27px;\n}\n\n.regkings .rk-info-item {\n  padding: 19px 0;\n  border-top: 1px solid #dce5e0;\n}\n\n.regkings .rk-info-item h3 {\n  color: #102b3b;\n  font-size: 16px;\n  margin: 0 0 5px;\n}\n\n.regkings .rk-info-item p {\n  color: #687982;\n  font-size: 14px;\n  margin: 0;\n}\n\n.regkings .rk-info-item a {\n  color: #12834f;\n  overflow-wrap: anywhere;\n}\n\n.regkings .rk-info-item a:hover {\n  text-decoration: underline;\n}\n\n/* CONTACT FORM */\n.regkings .rk-form-card {\n  background: #fff;\n  border: 1px solid #e0e7e3;\n  border-radius: 5px;\n  padding: 32px;\n}\n\n.regkings .rk-form-card h2 {\n  color: #102b3b;\n  font-size: 25px;\n  margin: 0 0 7px;\n}\n\n.regkings .rk-form-card > p {\n  color: #687982;\n  font-size: 14px;\n  margin: 0 0 24px;\n}\n\n.regkings .rk-form-row {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 17px;\n}\n\n.regkings .rk-field {\n  margin-bottom: 17px;\n}\n\n.regkings .rk-field label {\n  display: block;\n  color: #243b48;\n  font-size: 13px;\n  font-weight: 700;\n  margin-bottom: 6px;\n}\n\n.regkings .rk-field input,\n.regkings .rk-field select,\n.regkings .rk-field textarea {\n  width: 100%;\n  border: 1px solid #ccd8d1;\n  background: #fff;\n  color: #173344;\n  padding: 12px 13px;\n  border-radius: 4px;\n  font-family: inherit;\n  font-size: 14px;\n  outline: none;\n}\n\n.regkings .rk-field input:focus,\n.regkings .rk-field select:focus,\n.regkings .rk-field textarea:focus {\n  border-color: #20a967;\n  box-shadow: 0 0 0 2px rgba(32,200,120,.12);\n}\n\n.regkings .rk-field textarea {\n  resize: vertical;\n  min-height: 125px;\n}\n\n.regkings .rk-submit {\n  width: 100%;\n  border: 0;\n  border-radius: 4px;\n  padding: 14px 20px;\n  background: var(--rk-green);\n  color: #062033;\n  font-family: inherit;\n  font-size: 14px;\n  font-weight: 700;\n  cursor: pointer;\n  transition: background .2s ease;\n}\n\n.regkings .rk-submit:hover {\n  background: #47df96;\n}\n\n.regkings .rk-form-note {\n  color: #77868e;\n  font-size: 12px;\n  margin-top: 12px;\n}\n\n/* MEDICINE ENQUIRY BANNER */\n.regkings .rk-enquiry {\n  padding: 42px 0;\n  background: #0c293a;\n}\n\n.regkings .rk-enquiry-inner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 25px;\n}\n\n.regkings .rk-enquiry h2 {\n  color: #fff;\n  font-size: clamp(22px, 3vw, 29px);\n  line-height: 1.3;\n  margin: 0 0 7px;\n}\n\n.regkings .rk-enquiry p {\n  color: var(--rk-muted);\n  font-size: 14px;\n  margin: 0;\n}\n\n.regkings .rk-btn {\n  display: inline-block;\n  background: var(--rk-green);\n  color: #062033;\n  padding: 12px 21px;\n  border-radius: 4px;\n  font-size: 14px;\n  font-weight: 700;\n  white-space: nowrap;\n}\n\n/* FOOTER */\n.regkings .rk-footer {\n  padding: 32px 0 18px;\n  background: #04121d;\n}\n\n.regkings .rk-footer-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 25px;\n}\n\n.regkings .rk-footer p {\n  color: #96a9b4;\n  font-size: 13px;\n  margin: 9px 0;\n}\n\n.regkings .rk-footer-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.regkings .rk-footer-links a {\n  color: #c8d5dc;\n  font-size: 13px;\n}\n\n.regkings .rk-footer-links a:hover {\n  color: var(--rk-green);\n}\n\n.regkings .rk-copyright {\n  margin-top: 23px;\n  padding-top: 16px;\n  border-top: 1px solid rgba(255,255,255,.09);\n  color: #8297a3;\n  font-size: 12px;\n}\n\n/* RESPONSIVE */\n@media (max-width: 1000px) {\n  .regkings .rk-menu {\n    gap: 10px;\n  }\n\n  .regkings .rk-menu a {\n    font-size: 12px;\n  }\n\n  .regkings .rk-contact-grid {\n    gap: 28px;\n  }\n\n  .regkings .rk-form-card {\n    padding: 25px;\n  }\n}\n\n@media (max-width: 760px) {\n  .regkings .rk-nav-inner {\n    flex-wrap: wrap;\n    padding: 14px 0;\n  }\n\n  .regkings .rk-menu-btn {\n    display: block;\n  }\n\n  .regkings .rk-menu {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 0;\n  }\n\n  .regkings .rk-menu.rk-menu-open {\n    display: flex;\n  }\n\n  .regkings .rk-menu a {\n    padding: 10px 2px;\n    border-top: 1px solid rgba(255,255,255,.07);\n    font-size: 14px;\n  }\n\n  .regkings .rk-intro {\n    padding: 42px 0;\n  }\n\n  .regkings .rk-contact-section {\n    padding: 45px 0;\n  }\n\n  .regkings .rk-contact-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .regkings .rk-form-row {\n    grid-template-columns: 1fr;\n    gap: 0;\n  }\n\n  .regkings .rk-form-card {\n    padding: 22px;\n  }\n\n  .regkings .rk-enquiry-inner {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n\n  .regkings .rk-btn {\n    white-space: normal;\n  }\n}\n</style>\n\n<div class=\"regkings\">\n\n  <!-- NAVIGATION -->\n  <header class=\"rk-nav\">\n    <div class=\"rk-container rk-nav-inner\">\n\n      <a href=\"home.html\" class=\"rk-brand\">\n        RegKings\n        <span>PATENT &amp; COSMETIC STORES</span>\n      </a>\n\n      <button class=\"rk-menu-btn\" type=\"button\" aria-label=\"Toggle navigation\" aria-expanded=\"false\" onclick=\"(function(b){var m=b.parentElement.querySelector('.rk-menu');var o=m.classList.toggle('rk-menu-open');b.setAttribute('aria-expanded',o?'true':'false');})(this)\">\n        ☰\n      </button>\n\n      <nav class=\"rk-menu\" aria-label=\"Main navigation\">\n        <a href=\"home.html\">Home</a>\n        <a href=\"about.html\">About</a>\n        <a href=\"pharmacy.html\">Pharmacy</a>\n        <a href=\"patents.html\">Patent Medicines</a>\n        <a href=\"cosmetics.html\">Cosmetics</a>\n        <a href=\"contact.html\" class=\"rk-active\">Contact</a>\n        <a href=\"visit.html\">Visit Us</a>\n      </nav>\n\n    </div>\n  </header>\n\n  <!-- INTRODUCTION -->\n  <section data-bs-version=\"5.1\" class=\"rk-intro\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-breadcrumb\">\n        <a href=\"home.html\">Home</a> &nbsp;/&nbsp; Contact\n      </div>\n\n      <span class=\"rk-eyebrow\">Contact RegKings</span>\n\n      <h1>We're Here to Help.</h1>\n\n      <p>\n        Have a question about a medicine, healthcare product, or cosmetic\n        item? Get in touch with us for product enquiries and general\n        information about our store.\n      </p>\n\n    </div>\n  </section>\n\n  <!-- CONTACT INFORMATION AND FORM -->\n  <section class=\"rk-contact-section\">\n    <div class=\"rk-container rk-contact-grid\">\n\n      <!-- CONTACT DETAILS -->\n      <div class=\"rk-contact-info\">\n        <span class=\"rk-eyebrow\">Get in Touch</span>\n\n        <h2>How Can We Assist You?</h2>\n\n        <p>\n          Contact us to enquire about product availability, general store\n          information, or other questions relating to RegKings Patent\n          &amp; Cosmetic Stores.\n        </p>\n\n        <div class=\"rk-info-item\">\n          <h3>Phone / WhatsApp</h3>\n          <p>+234 7087199524.\n          </p>\n        </div>\n\n        <div class=\"rk-info-item\">\n          <h3>Email Address</h3>\n          <p>\n            forwisdomswork@gmail.com</p>\n        </div>\n\n        <div class=\"rk-info-item\">\n          <h3>Store Address</h3>\n          <p>\n            3 Femi Daramola St. Off Odo-Olowu, Ijeshatedo, Surulere, Lagos State.</p>\n        </div>\n\n        <div class=\"rk-info-item\">\n          <h3>Product Enquiries</h3>\n          <p>\n            Please confirm availability with the store before travelling\n            to purchase a particular item.\n          </p>\n        </div>\n      </div>\n\n      <!-- CONTACT FORM -->\n      <div class=\"rk-form-card\">\n        <h2>Send an Enquiry</h2>\n\n        <p>\n          Fill in the form below with your details and message.\n        </p>\n\n        <form id=\"rk-contact-form\">\n\n          <div class=\"rk-row\">\n            <div class=\"rk-field\">\n              <label for=\"rk-name\">Full Name *</label>\n              <input type=\"text\" id=\"rk-name\" name=\"name\" placeholder=\"Enter your name\" autocomplete=\"name\" required>\n            </div>\n\n            <div class=\"rk-field\">\n              <label for=\"rk-phone\">Phone Number *</label>\n              <input type=\"tel\" id=\"rk-phone\" name=\"phone\" placeholder=\"Enter your phone number\" autocomplete=\"tel\" required>\n            </div>\n          </div>\n\n          <div class=\"rk-field\">\n            <label for=\"rk-email\">Email Address</label>\n            <input type=\"email\" id=\"rk-email\" name=\"email\" placeholder=\"Enter your email address\" autocomplete=\"email\">\n          </div>\n\n          <div class=\"rk-field\">\n            <label for=\"rk-subject\">What Is Your Enquiry About? *</label>\n            <select id=\"rk-subject\" name=\"subject\" required>\n              <option value>Select an option</option>\n              <option value=\"Medicine enquiry\">Medicine enquiry</option>\n              <option value=\"Healthcare products\">Healthcare products</option>\n              <option value=\"Cosmetics and personal care\">Cosmetics and personal care</option>\n              <option value=\"Product availability\">Product availability</option>\n              <option value=\"Store information\">Store information</option>\n              <option value=\"Other enquiry\">Other enquiry</option>\n            </select>\n          </div>\n\n          <div class=\"rk-field\">\n            <label for=\"rk-message\">Your Message *</label>\n            <textarea id=\"rk-message\" name=\"message\" placeholder=\"Write your enquiry here...\" required></textarea>\n          </div>\n\n          <button type=\"submit\" class=\"rk-submit\">\n            Submit Enquiry\n          </button>\n\n          <p class=\"rk-form-note\">\n            Please do not include private medical records or other\n            sensitive personal information in this form.\n          </p>\n\n          <p id=\"rk-form-status\" role=\"status\" aria-live=\"polite\" style=\"font-size:13px;color:#9a3c2f;margin-top:12px;\">\n          </p>\n\n        </form>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- MEDICINE ENQUIRY -->\n  <section class=\"rk-enquiry\">\n    <div class=\"rk-container rk-enquiry-inner\">\n\n      <div>\n        <h2>Looking for a Medicine or Healthcare Product?</h2>\n        <p>\n          Visit our pharmacy page for more information about our main\n          business category.\n        </p>\n      </div>\n\n      <a href=\"pharmacy.html\" class=\"rk-btn\">Explore Pharmacy</a>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"rk-footer\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-footer-top\">\n        <div>\n          <a href=\"home.html\" class=\"rk-brand\">\n            RegKings\n            <span>PATENT &amp; COSMETIC STORES</span>\n          </a>\n\n          <p>\n            Medicines first, with additional products for everyday care.\n          </p>\n        </div>\n\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\n          <a href=\"home.html\">Home</a>\n          <a href=\"about.html\">About</a>\n          <a href=\"pharmacy.html\">Pharmacy</a>\n          <a href=\"patents.html\">Patent Medicines</a>\n          <a href=\"cosmetics.html\">Cosmetics</a>\n          <a href=\"contact.html\">Contact</a>\n          <a href=\"visit.html\">Visit Us</a>\n        </nav>\n      </div>\n\n      <div class=\"rk-copyright\">\n        © <span id=\"rk-year\">2026</span>\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\n      </div>\n\n    </div>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  var year = document.getElementById(\"rk-year\");\n\n  if (year) {\n    year.textContent = new Date().getFullYear();\n  }\n\n  var form = document.getElementById(\"rk-contact-form\");\n  var status = document.getElementById(\"rk-form-status\");\n\n  if (form && status) {\n    form.addEventListener(\"submit\", function (event) {\n      event.preventDefault();\n\n      status.style.color = \"#9a3c2f\";\n      status.textContent =\n        \"This form is not connected to an email service yet. Your message has not been sent. Please contact the store using its official contact details.\";\n    });\n  }\n})();\n</script>",
          "_cid": "GG6Bzy9rhK",
          "_anchor": "header09-a",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "visit.html": {
      "settings": {
        "title": "visit",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "6"
      },
      "components": [
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n.regkings {\n  --navy: #102b2b;\n  --green: #287653;\n  --light-green: #eaf3ed;\n  --ink: #243431;\n  --muted: #687570;\n  --line: #dce5df;\n  font-family: Arial, Helvetica, sans-serif;\n  color: var(--ink);\n  background: #ffffff;\n  line-height: 1.7;\n}\n.regkings * { box-sizing: border-box; }\n.regkings a { color: inherit; }\n.regkings .container {\n  width: min(1120px, 92%);\n  margin: auto;\n}\n.regkings .site-header {\n  background: var(--navy);\n  color: #ffffff;\n  padding: 17px 0;\n}\n.regkings .nav-row {\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n.regkings .brand {\n  color: #ffffff;\n  text-decoration: none;\n  font-size: 19px;\n  font-weight: 700;\n  line-height: 1.3;\n}\n.regkings .brand small {\n  display: block;\n  color: #c5d9ce;\n  font-size: 11px;\n  font-weight: 400;\n  letter-spacing: 1px;\n  margin-top: 4px;\n}\n.regkings .nav-links {\n  display: flex;\n  align-items: center;\n  flex-wrap: wrap;\n  gap: 17px;\n}\n.regkings .nav-links a {\n  color: #eaf2ed;\n  text-decoration: none;\n  font-size: 13px;\n}\n.regkings .nav-links a:hover,\n.regkings .nav-links a[aria-current=\"page\"] {\n  color: #a9dfba;\n}\n.regkings .menu-toggle {\n  display: none;\n  border: 1px solid #6c8c7c;\n  border-radius: 5px;\n  padding: 8px 11px;\n  background: transparent;\n  color: #ffffff;\n  cursor: pointer;\n}\n.regkings .page-intro {\n  padding: 65px 0 57px;\n  background: #f1f6f2;\n  border-bottom: 1px solid var(--line);\n}\n.regkings .eyebrow {\n  color: var(--green);\n  font-size: 12px;\n  font-weight: 700;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n}\n.regkings h1 {\n  color: var(--navy);\n  font-size: clamp(32px, 5vw, 48px);\n  line-height: 1.15;\n  letter-spacing: -1px;\n  margin: 13px 0 17px;\n}\n.regkings h2 {\n  color: var(--navy);\n  font-size: clamp(23px, 3vw, 31px);\n  line-height: 1.3;\n  margin: 0 0 14px;\n}\n.regkings h3 {\n  color: var(--navy);\n  font-size: 17px;\n  margin: 0 0 8px;\n}\n.regkings p { margin: 0 0 15px; }\n.regkings .intro-copy {\n  max-width: 690px;\n  color: #53625b;\n  font-size: 16px;\n}\n.regkings .section {\n  padding: 62px 0;\n}\n.regkings .location-grid {\n  display: grid;\n  grid-template-columns: 0.9fr 1.3fr;\n  gap: 32px;\n  align-items: stretch;\n}\n.regkings .location-panel {\n  padding: 28px;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: #ffffff;\n}\n.regkings .address {\n  color: var(--ink);\n  font-size: 16px;\n  font-weight: 600;\n  line-height: 1.8;\n  margin: 12px 0 22px;\n}\n.regkings .detail {\n  padding: 15px 0;\n  border-top: 1px solid var(--line);\n}\n.regkings .detail p {\n  color: var(--muted);\n  font-size: 14px;\n  margin: 0;\n}\n.regkings .button {\n  display: inline-block;\n  padding: 12px 17px;\n  border-radius: 5px;\n  background: var(--green);\n  color: #ffffff;\n  font-size: 14px;\n  font-weight: 700;\n  text-decoration: none;\n  margin-top: 8px;\n}\n.regkings .button:hover { background: #1d6041; }\n.regkings .button.secondary {\n  background: #ffffff;\n  color: var(--green);\n  border: 1px solid var(--green);\n}\n.regkings .map-wrap {\n  min-height: 450px;\n  overflow: hidden;\n  border: 1px solid var(--line);\n  border-radius: 8px;\n  background: #edf2ee;\n}\n.regkings .map-wrap iframe {\n  display: block;\n  width: 100%;\n  height: 100%;\n  min-height: 450px;\n  border: 0;\n}\n.regkings .map-note {\n  font-size: 12px;\n  color: var(--muted);\n  margin-top: 10px;\n}\n.regkings .visit-info {\n  background: #f5f8f5;\n  border-top: 1px solid var(--line);\n  border-bottom: 1px solid var(--line);\n}\n.regkings .info-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 24px;\n  margin-top: 28px;\n}\n.regkings .info-item {\n  background: #ffffff;\n  padding: 24px;\n  border: 1px solid var(--line);\n  border-radius: 7px;\n}\n.regkings .info-item p {\n  color: var(--muted);\n  font-size: 14px;\n  margin-bottom: 0;\n}\n.regkings .notice {\n  margin-top: 25px;\n  padding: 17px 20px;\n  border-left: 3px solid var(--green);\n  background: var(--light-green);\n  color: #3e5347;\n  font-size: 14px;\n}\n.regkings .cta {\n  padding: 45px 0;\n  background: var(--navy);\n  color: #ffffff;\n}\n.regkings .cta-row {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 24px;\n}\n.regkings .cta h2 { color: #ffffff; }\n.regkings .cta p {\n  color: #d2dfd7;\n  margin-bottom: 0;\n}\n.regkings .cta .button {\n  background: #ffffff;\n  color: var(--navy);\n  white-space: nowrap;\n}\n.regkings .footer {\n  background: #0b2020;\n  color: #d5e1da;\n  padding: 25px 0;\n  font-size: 12px;\n}\n.regkings .footer-row {\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 12px;\n}\n.regkings .footer p { margin: 0; }\n@media (max-width: 850px) {\n  .regkings .nav-row { flex-wrap: wrap; }\n  .regkings .menu-toggle { display: block; }\n  .regkings .nav-links {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    align-items: flex-start;\n    gap: 0;\n    padding-top: 8px;\n  }\n  .regkings .nav-links.open { display: flex; }\n  .regkings .nav-links a {\n    display: block;\n    width: 100%;\n    padding: 10px 0;\n    border-top: 1px solid #294646;\n  }\n  .regkings .location-grid { grid-template-columns: 1fr; }\n  .regkings .map-wrap,\n  .regkings .map-wrap iframe { min-height: 360px; }\n  .regkings .info-grid { grid-template-columns: 1fr; }\n  .regkings .cta-row {\n    align-items: flex-start;\n    flex-direction: column;\n  }\n}\n</style>\n\n<div class=\"regkings\">\n  <header class=\"site-header\">\n    <div class=\"container nav-row\">\n      <a class=\"brand\" href=\"home.html\">\n        RegKings\n        <small>PATENT &amp; COSMETIC STORES</small>\n      </a>\n\n      <button class=\"menu-toggle\" type=\"button\" aria-expanded=\"false\" aria-controls=\"regkings-nav\">\n        Menu\n      </button>\n\n      <nav class=\"nav-links\" id=\"regkings-nav\" aria-label=\"Main navigation\">\n        <a href=\"home.html\">Home</a>\n        <a href=\"about.html\">About</a>\n        <a href=\"pharmacy.html\">Pharmacy</a>\n        <a href=\"patents.html\">Patent Medicines</a>\n        <a href=\"cosmetics.html\">Cosmetics</a>\n        <a href=\"contact.html\">Contact</a>\n        <a href=\"visit.html\" aria-current=\"page\">Visit Us</a>\n      </nav>\n    </div>\n  </header>\n\n  <section data-bs-version=\"5.1\" class=\"page-intro\">\n    <div class=\"container\">\n      <div class=\"eyebrow\">Find our store</div>\n      <h1>Visit RegKings</h1>\n      <p class=\"intro-copy\">\n        We welcome you to RegKings Patent &amp; Cosmetic Stores in\n        Ijeshatedo, Surulere, Lagos. Use the map and address below to\n        plan your visit and enquire about the products you need.\n      </p>\n    </div>\n  </section>\n\n  <section class=\"section\">\n    <div class=\"container\">\n      <div class=\"location-grid\">\n        <div class=\"location-panel\">\n          <div class=\"eyebrow\">Our location</div>\n          <h2>For On-Site Assistance</h2>\n          <p>\n            Find us at the address below. If you are unfamiliar with\n            the area, open the map in Google Maps for directions.\n          </p>\n\n          <div class=\"address\">\n            No. 3 Femi Daramola Street,<br>\n            Off Odo-Olowu,<br>\n            Ijeshatedo, Surulere,<br>\n            Lagos State, Nigeria.\n          </div>\n\n          <a class=\"button\" target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.google.com/maps/dir/?api=1&destination=No+3+Femi+Daramola+Street%2C+Off+Odo-Olowu%2C+Ijeshatedo%2C+Surulere%2C+Lagos+State%2C+Nigeria\">\n            Get Directions\n          </a>\n\n          <div class=\"detail\">\n            <h3>What we offer</h3>\n            <p>\n              Enquiries about medicines and healthcare products,\n              alongside selected cosmetics and personal-care items.\n              Availability may vary.\n            </p>\n          </div>\n\n          <div class=\"detail\">\n            <h3>Opening hours</h3>\n            <p>\n              8:00 Am - 10:30 Pm.\n            </p>\n          </div>\n\n          <div class=\"detail\">\n            <h3>Need a particular product?</h3>\n            <p>\n              Contact the store before visiting to ask about product\n              availability. Only products the store is authorized\n              to sell should be supplied.\n            </p>\n            <a class=\"button secondary\" href=\"contact.html\">\n              Contact the Store\n            </a>\n          </div>\n        </div>\n\n        <div>\n          <div class=\"map-wrap\">\n            <iframe title=\"Google Maps search for RegKings Patent and Cosmetic Stores address\" src=\"https://maps.google.com/maps?q=No%203%20Femi%20Daramola%20Street%2C%20Off%20Odo-Olowu%2C%20Ijeshatedo%2C%20Surulere%2C%20Lagos%20State%2C%20Nigeria&output=embed\" loading=\"lazy\" referrerpolicy=\"no-referrer-when-downgrade\" allowfullscreen>\n            </iframe>\n          </div>\n          <p class=\"map-note\">\n            The map displays a Google Maps search for the supplied\n            address. Please verify the exact building location in\n            Google Maps before travelling.\n          </p>\n          <a target=\"_blank\" rel=\"noopener noreferrer\" href=\"https://www.google.com/maps/search/?api=1&query=No+3+Femi+Daramola+Street%2C+Off+Odo-Olowu%2C+Ijeshatedo%2C+Surulere%2C+Lagos+State%2C+Nigeria\">\n            Open this location in Google Maps\n          </a>\n        </div>\n      </div>\n    </div>\n  </section>\n\n  <section class=\"section visit-info\">\n    <div class=\"container\">\n      <div class=\"eyebrow\">Before you visit</div>\n      <h2>A few helpful details</h2>\n      <p>\n        We want your visit to be straightforward. These simple steps\n        can help you prepare before coming to the store.\n      </p>\n\n      <div class=\"info-grid\">\n        <div class=\"info-item\">\n          <h3>Plan your route</h3>\n          <p>\n            Use the Google Maps directions link above. Check the\n            suggested route and confirm the final street location\n            before setting out.\n          </p>\n        </div>\n\n        <div class=\"info-item\">\n          <h3>Check availability</h3>\n          <p>\n            If you need a specific product, enquire in advance.\n            A product shown or discussed online is not a guarantee\n            that it is currently available.\n          </p>\n        </div>\n\n        <div class=\"info-item\">\n          <h3>Medicine enquiries</h3>\n          <p>\n            For prescription medicines, bring the relevant prescription\n            where required. Ask an appropriately qualified healthcare\n            professional for advice about medicines.\n          </p>\n        </div>\n      </div>\n\n      <div class=\"notice\">\n        <strong>Please note:</strong> The exact Google Maps pin,\n        telephone number, email address, and confirmed opening hours\n        should be checked before being advertised as verified details.\n      </div>\n    </div>\n  </section>\n\n  <section class=\"cta\">\n    <div class=\"container cta-row\">\n      <div>\n        <h2>Looking for a particular product?</h2>\n        <p>\n          Send us an enquiry before visiting so you can plan ahead.\n        </p>\n      </div>\n      <a class=\"button\" href=\"contact.html\">Get in Touch</a>\n    </div>\n  </section>\n\n  <footer class=\"footer\">\n    <div class=\"container footer-row\">\n      <p>\n        © <span id=\"regkings-year\"></span>\n        RegKings Patent &amp; Cosmetic Stores.\n      </p>\n      <p>Ijeshatedo, Surulere, Lagos State, Nigeria.</p>\n    </div>\n  </footer>\n</div>\n\n<script>\n(function () {\n  var root = document.querySelector(\".regkings\");\n  if (!root) return;\n\n  var menuButton = root.querySelector(\".menu-toggle\");\n  var nav = root.querySelector(\".nav-links\");\n  var year = root.querySelector(\"#regkings-year\");\n\n  if (year) year.textContent = new Date().getFullYear();\n\n  if (menuButton && nav) {\n    menuButton.addEventListener(\"click\", function () {\n      var isOpen = nav.classList.toggle(\"open\");\n      menuButton.setAttribute(\"aria-expanded\", String(isOpen));\n    });\n  }\n})();\n</script>",
          "_cid": "GG6BG4tito",
          "_anchor": "header09-b",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        }
      ]
    },
    "about.html": {
      "settings": {
        "title": "about",
        "meta_descr": "",
        "header_custom": "",
        "footer_custom": "",
        "html_before": "",
        "order": "1"
      },
      "components": [
        {
          "alias": false,
          "_styles": {
            "H2": {
              "color": "#757b62"
            },
            "P": {
              "color": "#a6a99c"
            }
          },
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n<meta name=\"theme-color\" content=\"#0b1513\">\n<meta name=\"description\" content=\"Learn about RegKings Patent & Cosmetic Stores, our mission, healthcare essentials, skincare products and commitment to customer care.\">\n\n<title>About Us | RegKings Patent &amp; Cosmetic Stores</title>\n\n<style>\n/* =========================\n   REGKINGS WEBSITE STYLES\n========================= */\n\n:root {\n  --background: #0b1513;\n  --surface: #111f1b;\n  --surface-light: #192923;\n  --green: #10c982;\n  --green-light: #56e3a6;\n  --cream: #f5ead1;\n  --white: #ffffff;\n  --muted: #b4c2ba;\n  --border: rgba(255,255,255,0.09);\n}\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\n\nhtml {\n  scroll-behavior: smooth;\n  scroll-padding-top: 100px;\n}\n\nbody {\n  font-family: Arial, Helvetica, sans-serif;\n  background: var(--background);\n  color: var(--white);\n  line-height: 1.7;\n  overflow-x: hidden;\n}\n\na {\n  color: inherit;\n  text-decoration: none;\n}\n\nbutton {\n  font: inherit;\n}\n\nimg {\n  max-width: 100%;\n  display: block;\n}\n\n.container {\n  width: 90%;\n  max-width: 1180px;\n  margin: auto;\n}\n\n.section {\n  padding: 90px 0;\n}\n\n.eyebrow {\n  display: inline-block;\n  color: var(--green-light);\n  font-size: 12px;\n  font-weight: 800;\n  letter-spacing: 2px;\n  text-transform: uppercase;\n  margin-bottom: 16px;\n}\n\n.section-title {\n  font-size: clamp(30px, 4vw, 45px);\n  line-height: 1.2;\n  letter-spacing: -1.4px;\n  margin-bottom: 22px;\n  color: var(--cream);\n}\n\n.section-description {\n  color: var(--muted);\n  max-width: 650px;\n  font-size: 15px;\n}\n\n/* NAVIGATION */\n\n.site-header {\n  background: rgba(11, 21, 19, 0.97);\n  border-bottom: 1px solid var(--border);\n  position: sticky;\n  top: 0;\n  z-index: 1000;\n  backdrop-filter: blur(14px);\n}\n\n.navbar {\n  min-height: 88px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 24px;\n}\n\n.brand {\n  display: flex;\n  align-items: center;\n  gap: 11px;\n  flex-shrink: 0;\n}\n\n.brand-icon {\n  width: 45px;\n  height: 45px;\n  display: grid;\n  place-items: center;\n  color: var(--green);\n  font-size: 29px;\n  font-weight: bold;\n  border: 1px solid rgba(16,201,130,0.45);\n  background: rgba(16,201,130,0.09);\n  border-radius: 12px;\n}\n\n.brand-name {\n  font-size: 23px;\n  font-weight: 800;\n  letter-spacing: -1px;\n  line-height: 1.2;\n}\n\n.brand-name span {\n  color: var(--green);\n}\n\n.brand-caption {\n  font-size: 10px;\n  color: var(--muted);\n  line-height: 1.5;\n}\n\n.nav-links {\n  display: flex;\n  align-items: center;\n  gap: 19px;\n}\n\n.nav-links a {\n  font-size: 12px;\n  font-weight: 700;\n  color: #e0e8e2;\n  transition: color 0.25s ease;\n}\n\n.nav-links a:hover,\n.nav-links a.active {\n  color: var(--green-light);\n}\n\n.nav-links .store-link {\n  padding: 13px 19px;\n  background: var(--green);\n  color: #06251a;\n  border-radius: 30px;\n  white-space: nowrap;\n}\n\n.nav-links .store-link:hover {\n  background: var(--green-light);\n}\n\n.menu-toggle {\n  display: none;\n  width: 44px;\n  height: 44px;\n  background: var(--surface-light);\n  border: 1px solid var(--border);\n  color: white;\n  border-radius: 10px;\n  cursor: pointer;\n  font-size: 24px;\n}\n\n/* HERO */\n\n.about-hero {\n  padding: 95px 0 90px;\n  background:\n    radial-gradient(\n      ellipse at 85% 20%,\n      rgba(16,201,130,0.12),\n      transparent 40%\n    ),\n    var(--background);\n}\n\n.hero-grid {\n  display: grid;\n  grid-template-columns: 1.05fr 0.95fr;\n  align-items: center;\n  gap: 65px;\n}\n\n.hero-copy h1 {\n  color: var(--cream);\n  font-size: clamp(42px, 5vw, 65px);\n  line-height: 1.08;\n  letter-spacing: -2.5px;\n  margin-bottom: 24px;\n}\n\n.hero-copy h1 span {\n  color: var(--green);\n}\n\n.hero-copy p {\n  max-width: 560px;\n  color: var(--muted);\n  font-size: 16px;\n  margin-bottom: 30px;\n}\n\n.hero-actions {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 14px;\n}\n\n.btn {\n  display: inline-flex;\n  justify-content: center;\n  align-items: center;\n  padding: 14px 22px;\n  border-radius: 30px;\n  font-size: 13px;\n  font-weight: 800;\n  transition: 0.25s ease;\n}\n\n.btn-primary {\n  color: #06251a;\n  background: var(--green);\n}\n\n.btn-primary:hover {\n  background: var(--green-light);\n  transform: translateY(-2px);\n}\n\n.btn-outline {\n  border: 1px solid rgba(255,255,255,0.18);\n  color: var(--cream);\n}\n\n.btn-outline:hover {\n  border-color: var(--green);\n  color: var(--green-light);\n}\n\n.hero-visual {\n  min-height: 420px;\n  position: relative;\n  border: 1px solid rgba(16,201,130,0.22);\n  border-radius: 28px;\n  overflow: hidden;\n  background:\n    linear-gradient(\n      180deg,\n      rgba(11,21,19,0.02),\n      rgba(11,21,19,0.85)\n    ),\n    url(\"https://images.unsplash.com/photo-1608248543803-ba4f8c70ae0b?auto=format&fit=crop&w=1000&q=85\")\n    center / cover no-repeat,\n    #20372d;\n  box-shadow: 0 25px 70px rgba(0,0,0,0.25);\n}\n\n.hero-label {\n  position: absolute;\n  bottom: 20px;\n  left: 20px;\n  right: 20px;\n  padding: 20px;\n  border: 1px solid rgba(255,255,255,0.1);\n  background: rgba(11,21,19,0.88);\n  backdrop-filter: blur(12px);\n  border-radius: 16px;\n}\n\n.hero-label strong {\n  display: block;\n  color: var(--cream);\n  margin-bottom: 4px;\n  font-size: 16px;\n}\n\n.hero-label p {\n  color: var(--muted);\n  font-size: 13px;\n}\n\n/* INTRODUCTION */\n\n.intro-grid {\n  display: grid;\n  grid-template-columns: 0.9fr 1.1fr;\n  gap: 75px;\n  align-items: start;\n}\n\n.intro-panel {\n  padding: 32px;\n  background: linear-gradient(\n    135deg,\n    #172b23,\n    #101d19\n  );\n  border: 1px solid var(--border);\n  border-radius: 22px;\n}\n\n.intro-panel .big-plus {\n  width: 55px;\n  height: 55px;\n  display: grid;\n  place-items: center;\n  background: rgba(16,201,130,0.12);\n  border-radius: 15px;\n  color: var(--green);\n  font-size: 35px;\n  margin-bottom: 22px;\n}\n\n.intro-panel h3 {\n  font-size: 24px;\n  color: var(--cream);\n  margin-bottom: 12px;\n}\n\n.intro-panel p,\n.intro-copy p {\n  color: var(--muted);\n  font-size: 15px;\n}\n\n.intro-copy p + p {\n  margin-top: 17px;\n}\n\n.intro-copy .section-title {\n  max-width: 530px;\n}\n\n/* MISSION AND VALUES */\n\n.values-section {\n  background: #0e1b17;\n  border-top: 1px solid var(--border);\n  border-bottom: 1px solid var(--border);\n}\n\n.center-heading {\n  text-align: center;\n  margin-bottom: 48px;\n}\n\n.center-heading .section-description {\n  margin: 0 auto;\n}\n\n.values-grid {\n  display: grid;\n  grid-template-columns: repeat(3, 1fr);\n  gap: 22px;\n}\n\n.value-card {\n  padding: 30px 26px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  border-radius: 20px;\n  transition: transform 0.25s, border-color 0.25s;\n}\n\n.value-card:hover {\n  transform: translateY(-5px);\n  border-color: rgba(16,201,130,0.5);\n}\n\n.value-icon {\n  display: grid;\n  place-items: center;\n  width: 52px;\n  height: 52px;\n  background: rgba(16,201,130,0.12);\n  color: var(--green-light);\n  border-radius: 15px;\n  font-size: 25px;\n  margin-bottom: 21px;\n}\n\n.value-card h3 {\n  font-size: 19px;\n  color: var(--cream);\n  margin-bottom: 12px;\n}\n\n.value-card p {\n  font-size: 14px;\n  color: var(--muted);\n}\n\n/* PRODUCT CATEGORIES */\n\n.categories-grid {\n  display: grid;\n  grid-template-columns: repeat(4, 1fr);\n  gap: 18px;\n  margin-top: 38px;\n}\n\n.category-card {\n  min-height: 210px;\n  padding: 25px 20px;\n  border-radius: 18px;\n  background: var(--surface);\n  border: 1px solid var(--border);\n  display: flex;\n  flex-direction: column;\n  justify-content: space-between;\n  transition: 0.25s ease;\n}\n\n.category-card:hover {\n  border-color: var(--green);\n  background: var(--surface-light);\n  transform: translateY(-4px);\n}\n\n.category-symbol {\n  color: var(--green-light);\n  font-size: 32px;\n  margin-bottom: 20px;\n}\n\n.category-card h3 {\n  font-size: 17px;\n  color: var(--cream);\n  margin-bottom: 7px;\n}\n\n.category-card p {\n  font-size: 13px;\n  color: var(--muted);\n}\n\n/* CUSTOMER CARE */\n\n.care-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 60px;\n  align-items: center;\n}\n\n.care-visual {\n  min-height: 360px;\n  border-radius: 24px;\n  overflow: hidden;\n  background:\n    linear-gradient(\n      180deg,\n      rgba(11,21,19,0.02),\n      rgba(11,21,19,0.6)\n    ),\n    url(\"https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?auto=format&fit=crop&w=1000&q=85\")\n    center / cover no-repeat,\n    #1b3529;\n}\n\n.care-list {\n  list-style: none;\n  margin-top: 25px;\n}\n\n.care-list li {\n  display: flex;\n  gap: 13px;\n  align-items: flex-start;\n  margin-bottom: 17px;\n  color: var(--muted);\n  font-size: 14px;\n}\n\n.care-list li span {\n  color: var(--green);\n  font-weight: bold;\n}\n\n/* CALL TO ACTION */\n\n.cta-section {\n  padding: 40px 0 90px;\n}\n\n.cta-panel {\n  text-align: center;\n  padding: 60px 30px;\n  border: 1px solid rgba(16,201,130,0.25);\n  border-radius: 28px;\n  background:\n    radial-gradient(\n      ellipse at top,\n      rgba(16,201,130,0.15),\n      transparent 65%\n    ),\n    #111f1b;\n}\n\n.cta-panel h2 {\n  font-size: clamp(30px, 4vw, 43px);\n  line-height: 1.2;\n  color: var(--cream);\n  margin-bottom: 17px;\n}\n\n.cta-panel p {\n  max-width: 600px;\n  margin: 0 auto 26px;\n  color: var(--muted);\n  font-size: 15px;\n}\n\n/* FOOTER */\n\n.site-footer {\n  padding: 45px 0 22px;\n  background: #080f0d;\n  border-top: 1px solid var(--border);\n}\n\n.footer-main {\n  display: flex;\n  justify-content: space-between;\n  gap: 35px;\n  flex-wrap: wrap;\n  padding-bottom: 30px;\n}\n\n.footer-about {\n  max-width: 340px;\n}\n\n.footer-about p {\n  margin-top: 15px;\n  color: var(--muted);\n  font-size: 13px;\n}\n\n.footer-heading {\n  font-size: 14px;\n  color: var(--cream);\n  margin-bottom: 13px;\n}\n\n.footer-links {\n  display: flex;\n  flex-direction: column;\n  gap: 8px;\n}\n\n.footer-links a {\n  font-size: 13px;\n  color: var(--muted);\n}\n\n.footer-links a:hover {\n  color: var(--green-light);\n}\n\n.footer-bottom {\n  padding-top: 20px;\n  border-top: 1px solid var(--border);\n  color: #899a91;\n  font-size: 12px;\n  display: flex;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 10px;\n}\n\n/* RESPONSIVE DESIGN */\n\n@media (max-width: 1050px) {\n  .navbar {\n    gap: 14px;\n  }\n\n  .nav-links {\n    gap: 12px;\n  }\n\n  .nav-links a {\n    font-size: 11px;\n  }\n\n  .brand-name {\n    font-size: 21px;\n  }\n\n  .hero-grid {\n    gap: 35px;\n  }\n\n  .categories-grid {\n    grid-template-columns: repeat(2, 1fr);\n  }\n}\n\n@media (max-width: 800px) {\n  .section {\n    padding: 65px 0;\n  }\n\n  .navbar {\n    min-height: 76px;\n  }\n\n  .menu-toggle {\n    display: block;\n  }\n\n  .nav-links {\n    display: none;\n    position: absolute;\n    top: 76px;\n    left: 0;\n    right: 0;\n    padding: 20px 5% 25px;\n    background: #0d1915;\n    border-bottom: 1px solid var(--border);\n    flex-direction: column;\n    align-items: stretch;\n    gap: 0;\n    max-height: calc(100vh - 76px);\n    overflow-y: auto;\n  }\n\n  .nav-links.open {\n    display: flex;\n  }\n\n  .nav-links a {\n    display: block;\n    padding: 12px 0;\n    font-size: 14px;\n    border-bottom: 1px solid var(--border);\n  }\n\n  .nav-links .store-link {\n    margin-top: 14px;\n    text-align: center;\n    border: 0;\n  }\n\n  .about-hero {\n    padding: 65px 0;\n  }\n\n  .hero-grid,\n  .intro-grid,\n  .care-grid {\n    grid-template-columns: 1fr;\n    gap: 35px;\n  }\n\n  .hero-copy h1 {\n    font-size: clamp(42px, 9vw, 58px);\n  }\n\n  .hero-visual {\n    min-height: 350px;\n  }\n\n  .intro-panel {\n    padding: 25px;\n  }\n\n  .values-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .care-visual {\n    min-height: 300px;\n  }\n\n  .cta-panel {\n    padding: 45px 22px;\n  }\n}\n\n@media (max-width: 480px) {\n  .container {\n    width: 90%;\n  }\n\n  .brand-icon {\n    width: 40px;\n    height: 40px;\n  }\n\n  .brand-name {\n    font-size: 20px;\n  }\n\n  .brand-caption {\n    font-size: 9px;\n  }\n\n  .hero-copy h1 {\n    font-size: 42px;\n    letter-spacing: -1.5px;\n  }\n\n  .hero-copy p {\n    font-size: 14px;\n  }\n\n  .hero-visual {\n    min-height: 290px;\n    border-radius: 20px;\n  }\n\n  .categories-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .category-card {\n    min-height: 170px;\n  }\n\n  .footer-main {\n    flex-direction: column;\n  }\n\n  .footer-bottom {\n    flex-direction: column;\n  }\n}\n\n@media (prefers-reduced-motion: reduce) {\n  html {\n    scroll-behavior: auto;\n  }\n\n  *,\n  *::before,\n  *::after {\n    transition-duration: 0.01ms !important;\n  }\n}\n</style>\n\n\n\n\n<!-- NAVIGATION -->\n<header class=\"site-header\">\n  <div class=\"container navbar\">\n\n    <a class=\"brand\" href=\"index.html\" aria-label=\"RegKings Home\">\n      <div class=\"brand-icon\">+</div>\n      <div>\n        <div class=\"brand-name\">Reg<span>Kings</span></div>\n        <div class=\"brand-caption\">\n          Patent &amp; Cosmetic Stores\n        </div>\n      </div>\n    </a>\n\n    <button class=\"menu-toggle\" id=\"menuToggle\" type=\"button\" aria-label=\"Open navigation menu\" aria-expanded=\"false\" aria-controls=\"mainNavigation\">☰</button>\n\n    <nav class=\"nav-links\" id=\"mainNavigation\" aria-label=\"Main navigation\">\n      <a href=\"index.html\">Home</a>\n      <a href=\"about.html\" class=\"active\" aria-current=\"page\">About</a>\n      <a href=\"pharmacy.html\">Pharmacy</a>\n      <a href=\"patents.html\">Patents</a>\n      <a href=\"cosmetics.html\">Cosmetics</a>\n      <a href=\"products.html\">Products</a>\n      <a href=\"contact.html\">Contact</a>\n      <a href=\"stores.html\" class=\"store-link\">Visit Our Stores</a>\n    </nav>\n\n  </div>\n</header>\n\n<main>\n\n  <!-- ABOUT HERO -->\n  <section class=\"about-hero\">\n    <div class=\"container hero-grid\">\n\n      <div class=\"hero-copy\">\n        <span class=\"eyebrow\">GET TO KNOW REGKINGS</span>\n\n        <h1>\n          Your Health.<br>\n          Our <span>Priority.</span>\n        </h1>\n\n        <p>\n          Welcome to RegKings Patent &amp; Cosmetic Stores,\n          your destination for healthcare essentials, patent\n          medicine products, skincare and beauty items.\n          We are committed to helping our customers find\n          products that suit their everyday needs.\n        </p>\n\n        <div class=\"hero-actions\">\n          <a href=\"products.html\" class=\"btn btn-primary\">\n            Explore Products →\n          </a>\n\n          <a href=\"#our-story\" class=\"btn btn-outline\">\n            Our Story\n          </a>\n        </div>\n      </div>\n\n      <div class=\"hero-visual\" role=\"img\" aria-label=\"Skincare and personal care products\">\n        <div class=\"hero-label\">\n          <strong>Health. Beauty. Wellness.</strong>\n          <p>Care you can count on.</p>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- OUR STORY -->\n  <section class=\"section\" id=\"our-story\">\n    <div class=\"container intro-grid\">\n\n      <div class=\"intro-panel\">\n        <div class=\"big-plus\">+</div>\n\n        <span class=\"eyebrow\">WHO WE ARE</span>\n\n        <h3>More Than Products. A Commitment to Care.</h3>\n\n        <p>\n          At RegKings Patent &amp; Cosmetic Stores, we believe\n          that shopping for healthcare and beauty essentials\n          should be a straightforward and welcoming experience.\n        </p>\n      </div>\n\n      <div class=\"intro-copy\">\n        <span class=\"eyebrow\">OUR STORY</span>\n\n        <h2 class=\"section-title\">\n          Helping You Care for Yourself, Every Day.\n        </h2>\n\n        <p>\n          RegKings Patent &amp; Cosmetic Stores brings together\n          everyday healthcare essentials, skincare, cosmetics\n          and personal-care products in one convenient place.\n        </p>\n\n        <p>\n          We aim to provide a welcoming shopping experience,\n          helpful customer service and access to products that\n          support everyday personal care and wellbeing.\n        </p>\n\n        <p>\n          Whether you are looking for beauty essentials or\n          healthcare products, our goal is to help you shop\n          with confidence and receive respectful service.\n        </p>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- MISSION AND VALUES -->\n  <section class=\"section values-section\">\n    <div class=\"container\">\n\n      <div class=\"center-heading\">\n        <span class=\"eyebrow\">WHAT GUIDES US</span>\n        <h2 class=\"section-title\">Our Mission &amp; Values</h2>\n\n        <p class=\"section-description\">\n          The principles behind the way we serve our customers\n          and approach healthcare, beauty and personal care.\n        </p>\n      </div>\n\n      <div class=\"values-grid\">\n\n        <article class=\"value-card\">\n          <div class=\"value-icon\" aria-hidden=\"true\">✚</div>\n          <h3>Customer Care</h3>\n          <p>\n            We strive to treat every customer with respect,\n            provide helpful service and make every visit\n            a welcoming experience.\n          </p>\n        </article>\n\n        <article class=\"value-card\">\n          <div class=\"value-icon\" aria-hidden=\"true\">✦</div>\n          <h3>Quality &amp; Trust</h3>\n          <p>\n            We aim to offer genuine products sourced through\n            appropriate channels and help customers make\n            informed purchasing decisions.\n          </p>\n        </article>\n\n        <article class=\"value-card\">\n          <div class=\"value-icon\" aria-hidden=\"true\">♡</div>\n          <h3>Responsible Care</h3>\n          <p>\n            We value responsible medicine sales, appropriate\n            guidance and the wellbeing of the people\n            who trust our store.\n          </p>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- WHAT WE OFFER -->\n  <section class=\"section\" id=\"what-we-offer\">\n    <div class=\"container\">\n\n      <span class=\"eyebrow\">EXPLORE OUR RANGE</span>\n\n      <h2 class=\"section-title\">\n        Products for Your Everyday Needs.\n      </h2>\n\n      <p class=\"section-description\">\n        Discover our range of healthcare and personal-care\n        categories. Availability may vary by store.\n      </p>\n\n      <div class=\"categories-grid\">\n\n        <a href=\"pharmacy.html\" class=\"category-card\">\n          <div>\n            <div class=\"category-symbol\" aria-hidden=\"true\">✚</div>\n            <h3>Pharmacy</h3>\n            <p>\n              Explore available healthcare essentials\n              and pharmacy-related products.\n            </p>\n          </div>\n        </a>\n\n        <a href=\"patents.html\" class=\"category-card\">\n          <div>\n            <div class=\"category-symbol\" aria-hidden=\"true\">＋</div>\n            <h3>Patent Medicine</h3>\n            <p>\n              Learn about available patent medicine\n              products and responsible purchasing.\n            </p>\n          </div>\n        </a>\n\n        <a href=\"cosmetics.html\" class=\"category-card\">\n          <div>\n            <div class=\"category-symbol\" aria-hidden=\"true\">✧</div>\n            <h3>Cosmetics &amp; Skincare</h3>\n            <p>\n              Discover beauty, skincare and\n              personal-care essentials.\n            </p>\n          </div>\n        </a>\n\n        <a href=\"products.html\" class=\"category-card\">\n          <div>\n            <div class=\"category-symbol\" aria-hidden=\"true\">◇</div>\n            <h3>Everyday Essentials</h3>\n            <p>\n              Browse other personal-care and\n              wellness products available in store.\n            </p>\n          </div>\n        </a>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- CUSTOMER CARE -->\n  <section class=\"section values-section\">\n    <div class=\"container care-grid\">\n\n      <div class=\"care-visual\" role=\"img\" aria-label=\"Healthcare professional in a clinical setting\">\n      </div>\n\n      <div>\n        <span class=\"eyebrow\">OUR COMMITMENT</span>\n\n        <h2 class=\"section-title\">\n          Care That Puts People First.\n        </h2>\n\n        <p class=\"section-description\">\n          We want every customer to feel welcome, informed\n          and respected when shopping with RegKings.\n        </p>\n\n        <ul class=\"care-list\">\n          <li>\n            <span>✓</span>\n            <div>\n              <strong>Helpful service</strong><br>\n              We aim to make your shopping experience\n              clear, friendly and convenient.\n            </div>\n          </li>\n\n          <li>\n            <span>✓</span>\n            <div>\n              <strong>Responsible medicine sales</strong><br>\n              Medicines should be supplied and used\n              responsibly, with appropriate professional\n              guidance when needed.\n            </div>\n          </li>\n\n          <li>\n            <span>✓</span>\n            <div>\n              <strong>Customer confidence</strong><br>\n              We aim to help customers understand product\n              information and make informed choices.\n            </div>\n          </li>\n        </ul>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- CALL TO ACTION -->\n  <section class=\"cta-section\" id=\"visit-us\">\n    <div class=\"container\">\n      <div class=\"cta-panel\">\n\n        <span class=\"eyebrow\">WE WOULD LOVE TO SERVE YOU</span>\n\n        <h2>\n          Your Health. Your Beauty.<br>\n          Your Everyday Essentials.\n        </h2>\n\n        <p>\n          Explore our products or get in touch with RegKings\n          Patent &amp; Cosmetic Stores to learn more about\n          what we offer.\n        </p>\n\n        <div class=\"hero-actions\" style=\"justify-content:center;\">\n          <a href=\"products.html\" class=\"btn btn-primary\">\n            Browse Products →\n          </a>\n\n          <a href=\"contact.html\" class=\"btn btn-outline\">\n            Contact Us\n          </a>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n</main>\n\n<!-- FOOTER -->\n<footer class=\"site-footer\">\n  <div class=\"container\">\n\n    <div class=\"footer-main\">\n\n      <div class=\"footer-about\">\n        <a class=\"brand\" href=\"index.html\">\n          <div class=\"brand-icon\">+</div>\n          <div>\n            <div class=\"brand-name\">\n              Reg<span>Kings</span>\n            </div>\n            <div class=\"brand-caption\">\n              Patent &amp; Cosmetic Stores\n            </div>\n          </div>\n        </a>\n\n        <p>\n          Healthcare essentials, skincare and beauty\n          products for your everyday needs.\n        </p>\n      </div>\n\n      <div>\n        <h3 class=\"footer-heading\">Quick Links</h3>\n        <div class=\"footer-links\">\n          <a href=\"index.html\">Home</a>\n          <a href=\"about.html\">About Us</a>\n          <a href=\"products.html\">Products</a>\n          <a href=\"contact.html\">Contact</a>\n        </div>\n      </div>\n\n      <div>\n        <h3 class=\"footer-heading\">Our Categories</h3>\n        <div class=\"footer-links\">\n          <a href=\"pharmacy.html\">Pharmacy</a>\n          <a href=\"patents.html\">Patents</a>\n          <a href=\"cosmetics.html\">Cosmetics</a>\n          <a href=\"stores.html\">Visit Our Stores</a>\n        </div>\n      </div>\n\n    </div>\n\n    <div class=\"footer-bottom\">\n      <p>\n        © <span id=\"currentYear\"></span>\n        RegKings Patent &amp; Cosmetic Stores.\n        All rights reserved.\n      </p>\n      <p>Health. Beauty. Wellness.</p>\n    </div>\n\n  </div>\n</footer>\n\n<script>\n/* =========================\n   REGKINGS WEBSITE SCRIPT\n========================= */\n\n(function () {\n  \"use strict\";\n\n  var menuButton = document.getElementById(\"menuToggle\");\n  var navigation = document.getElementById(\"mainNavigation\");\n\n  // Mobile navigation menu\n  if (menuButton && navigation) {\n\n    menuButton.addEventListener(\"click\", function () {\n      var isOpen = navigation.classList.toggle(\"open\");\n\n      menuButton.setAttribute(\"aria-expanded\", String(isOpen));\n\n      menuButton.setAttribute(\n        \"aria-label\",\n        isOpen ? \"Close navigation menu\" : \"Open navigation menu\"\n      );\n\n      menuButton.textContent = isOpen ? \"×\" : \"☰\";\n    });\n\n    // Close the menu after a navigation link is selected\n    var navLinks = navigation.querySelectorAll(\"a\");\n\n    navLinks.forEach(function (link) {\n      link.addEventListener(\"click\", function () {\n        navigation.classList.remove(\"open\");\n        menuButton.setAttribute(\"aria-expanded\", \"false\");\n        menuButton.setAttribute(\"aria-label\", \"Open navigation menu\");\n        menuButton.textContent = \"☰\";\n      });\n    });\n\n    // Close the menu when returning to desktop width\n    window.addEventListener(\"resize\", function () {\n      if (window.innerWidth > 800) {\n        navigation.classList.remove(\"open\");\n        menuButton.setAttribute(\"aria-expanded\", \"false\");\n        menuButton.setAttribute(\"aria-label\", \"Open navigation menu\");\n        menuButton.textContent = \"☰\";\n      }\n    });\n  }\n\n  // Automatically update the copyright year\n  var yearElement = document.getElementById(\"currentYear\");\n\n  if (yearElement) {\n    yearElement.textContent = new Date().getFullYear();\n  }\n\n})();\n</script>",
