      "components": [
        {
          "alias": false,
          "_styles": {},
          "_name": "header09",
          "_sourceTheme": "startm5",
          "_customHTML": "<style>\n/* REGKINGS COSMETICS PAGE */\n.regkings {\n  --rk-navy: #071b2b;\n  --rk-green: #20c878;\n  --rk-white: #ffffff;\n  --rk-muted: #b8c7d0;\n  font-family: Arial, Helvetica, sans-serif;\n  color: var(--rk-white);\n  background: var(--rk-navy);\n  line-height: 1.7;\n  overflow: hidden;\n}\n\n.regkings * {\n  box-sizing: border-box;\n}\n\n.regkings a {\n  text-decoration: none;\n}\n\n.regkings .rk-container {\n  width: 92%;\n  max-width: 1180px;\n  margin: auto;\n}\n\n/* NAVIGATION */\n.regkings .rk-nav {\n  background: #061522;\n  border-bottom: 1px solid rgba(255,255,255,.08);\n  position: relative;\n  z-index: 10;\n}\n\n.regkings .rk-nav-inner {\n  min-height: 82px;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  gap: 20px;\n}\n\n.regkings .rk-brand {\n  color: #fff;\n  font-size: 21px;\n  font-weight: 800;\n  line-height: 1.25;\n}\n\n.regkings .rk-brand span {\n  display: block;\n  color: var(--rk-green);\n  font-size: 11px;\n  letter-spacing: 1.8px;\n  margin-top: 5px;\n}\n\n.regkings .rk-menu {\n  display: flex;\n  align-items: center;\n  gap: 17px;\n}\n\n.regkings .rk-menu a {\n  color: #d8e2e8;\n  font-size: 13px;\n  transition: color .2s ease;\n}\n\n.regkings .rk-menu a:hover,\n.regkings .rk-menu a.rk-active {\n  color: var(--rk-green);\n}\n\n.regkings .rk-menu-btn {\n  display: none;\n  border: 1px solid #415566;\n  border-radius: 5px;\n  padding: 7px 12px;\n  color: #fff;\n  background: transparent;\n  font-size: 22px;\n  cursor: pointer;\n}\n\n/* INTRODUCTION */\n.regkings .rk-intro {\n  padding: 65px 0;\n  background: #0a2334;\n  border-bottom: 3px solid var(--rk-green);\n}\n\n.regkings .rk-breadcrumb {\n  color: #a9bac5;\n  font-size: 12px;\n  margin-bottom: 23px;\n}\n\n.regkings .rk-breadcrumb a {\n  color: var(--rk-green);\n}\n\n.regkings .rk-intro-grid {\n  display: grid;\n  grid-template-columns: 1.25fr .75fr;\n  align-items: center;\n  gap: 55px;\n}\n\n.regkings .rk-eyebrow {\n  color: var(--rk-green);\n  font-size: 12px;\n  text-transform: uppercase;\n  font-weight: 700;\n  letter-spacing: 2px;\n}\n\n.regkings .rk-intro h1 {\n  font-size: clamp(35px, 4.5vw, 52px);\n  line-height: 1.15;\n  color: #fff;\n  margin: 13px 0 18px;\n}\n\n.regkings .rk-intro p {\n  color: var(--rk-muted);\n  margin: 0 0 24px;\n  max-width: 620px;\n}\n\n.regkings .rk-intro-note {\n  border-left: 3px solid var(--rk-green);\n  padding: 12px 0 12px 23px;\n}\n\n.regkings .rk-intro-note h3 {\n  color: #fff;\n  font-size: 21px;\n  line-height: 1.4;\n  margin: 0 0 10px;\n}\n\n.regkings .rk-intro-note p {\n  font-size: 14px;\n  margin: 0;\n}\n\n/* BUTTONS */\n.regkings .rk-btn {\n  display: inline-block;\n  background: var(--rk-green);\n  color: #062033;\n  padding: 12px 21px;\n  border-radius: 4px;\n  font-size: 14px;\n  font-weight: 700;\n  transition: background .2s ease;\n}\n\n.regkings .rk-btn:hover {\n  background: #47df96;\n}\n\n.regkings .rk-outline {\n  display: inline-block;\n  color: #fff;\n  border: 1px solid #718592;\n  padding: 11px 20px;\n  border-radius: 4px;\n  margin-left: 9px;\n  font-size: 14px;\n}\n\n.regkings .rk-outline:hover {\n  color: var(--rk-green);\n  border-color: var(--rk-green);\n}\n\n/* COSMETICS CATEGORIES */\n.regkings .rk-section {\n  padding: 68px 0;\n}\n\n.regkings .rk-section-light {\n  background: #f5f7f6;\n  color: #172e3a;\n}\n\n.regkings .rk-section-heading {\n  max-width: 730px;\n  margin-bottom: 35px;\n}\n\n.regkings .rk-section-heading h2 {\n  font-size: clamp(27px, 3.5vw, 36px);\n  line-height: 1.25;\n  margin: 9px 0 12px;\n}\n\n.regkings .rk-section-heading p {\n  color: #697982;\n  margin: 0;\n}\n\n.regkings .rk-category-grid {\n  display: grid;\n  grid-template-columns: repeat(3, minmax(0, 1fr));\n  gap: 24px;\n}\n\n.regkings .rk-category {\n  background: #fff;\n  border: 1px solid #e0e6e2;\n  border-radius: 5px;\n  overflow: hidden;\n  transition: border-color .2s ease;\n}\n\n.regkings .rk-category:hover {\n  border-color: #8bcfae;\n}\n\n.regkings .rk-category-top {\n  height: 5px;\n  background: var(--rk-green);\n}\n\n.regkings .rk-category-content {\n  padding: 25px;\n}\n\n.regkings .rk-category-label {\n  color: #168451;\n  font-size: 11px;\n  font-weight: 800;\n  letter-spacing: 1.5px;\n  text-transform: uppercase;\n}\n\n.regkings .rk-category h3 {\n  color: #102b3b;\n  font-size: 19px;\n  margin: 8px 0;\n}\n\n.regkings .rk-category p {\n  color: #687982;\n  font-size: 14px;\n  margin: 0;\n}\n\n/* SHOPPING INFORMATION */\n.regkings .rk-info {\n  padding: 65px 0;\n  background: #0c293a;\n}\n\n.regkings .rk-info-grid {\n  display: grid;\n  grid-template-columns: 1fr 1fr;\n  gap: 55px;\n  align-items: start;\n}\n\n.regkings .rk-info h2 {\n  color: #fff;\n  font-size: clamp(27px, 3.5vw, 36px);\n  line-height: 1.25;\n  margin: 10px 0 16px;\n}\n\n.regkings .rk-info p {\n  color: var(--rk-muted);\n  font-size: 14px;\n}\n\n.regkings .rk-info-list {\n  border-top: 1px solid #365064;\n}\n\n.regkings .rk-info-item {\n  padding: 17px 0;\n  border-bottom: 1px solid #365064;\n}\n\n.regkings .rk-info-item h3 {\n  color: #fff;\n  font-size: 16px;\n  margin: 0 0 5px;\n}\n\n.regkings .rk-info-item p {\n  margin: 0;\n}\n\n/* MEDICINES FIRST */\n.regkings .rk-medicines {\n  padding: 43px 0;\n  background: #eaf5ee;\n  color: #173344;\n}\n\n.regkings .rk-medicines-inner {\n  display: flex;\n  justify-content: space-between;\n  align-items: center;\n  gap: 25px;\n}\n\n.regkings .rk-medicines h2 {\n  font-size: clamp(23px, 3vw, 30px);\n  line-height: 1.3;\n  margin: 0 0 8px;\n}\n\n.regkings .rk-medicines p {\n  color: #60736b;\n  margin: 0;\n}\n\n/* FOOTER */\n.regkings .rk-footer {\n  padding: 32px 0 18px;\n  background: #04121d;\n}\n\n.regkings .rk-footer-top {\n  display: flex;\n  align-items: flex-start;\n  justify-content: space-between;\n  flex-wrap: wrap;\n  gap: 25px;\n}\n\n.regkings .rk-footer p {\n  color: #96a9b4;\n  font-size: 13px;\n  margin: 9px 0;\n}\n\n.regkings .rk-footer-links {\n  display: flex;\n  flex-wrap: wrap;\n  gap: 15px;\n}\n\n.regkings .rk-footer-links a {\n  color: #c8d5dc;\n  font-size: 13px;\n}\n\n.regkings .rk-footer-links a:hover {\n  color: var(--rk-green);\n}\n\n.regkings .rk-copyright {\n  margin-top: 23px;\n  padding-top: 16px;\n  border-top: 1px solid rgba(255,255,255,.09);\n  color: #8297a3;\n  font-size: 12px;\n}\n\n/* RESPONSIVE LAYOUT */\n@media (max-width: 1000px) {\n  .regkings .rk-menu {\n    gap: 10px;\n  }\n\n  .regkings .rk-menu a {\n    font-size: 12px;\n  }\n\n  .regkings .rk-category-grid {\n    grid-template-columns: repeat(2, minmax(0, 1fr));\n  }\n}\n\n@media (max-width: 760px) {\n  .regkings .rk-nav-inner {\n    flex-wrap: wrap;\n    padding: 14px 0;\n  }\n\n  .regkings .rk-menu-btn {\n    display: block;\n  }\n\n  .regkings .rk-menu {\n    display: none;\n    width: 100%;\n    flex-direction: column;\n    align-items: stretch;\n    gap: 0;\n  }\n\n  .regkings .rk-menu.rk-menu-open {\n    display: flex;\n  }\n\n  .regkings .rk-menu a {\n    padding: 10px 2px;\n    border-top: 1px solid rgba(255,255,255,.07);\n    font-size: 14px;\n  }\n\n  .regkings .rk-intro {\n    padding: 45px 0;\n  }\n\n  .regkings .rk-intro-grid,\n  .regkings .rk-info-grid {\n    grid-template-columns: 1fr;\n    gap: 28px;\n  }\n\n  .regkings .rk-section {\n    padding: 48px 0;\n  }\n\n  .regkings .rk-category-grid {\n    grid-template-columns: 1fr;\n  }\n\n  .regkings .rk-medicines-inner {\n    flex-direction: column;\n    align-items: flex-start;\n  }\n\n  .regkings .rk-outline {\n    margin: 12px 0 0;\n  }\n}\n</style>\n\n<div class=\"regkings\">\n\n  <!-- NAVIGATION -->\n  <header class=\"rk-nav\">\n    <div class=\"rk-container rk-nav-inner\">\n\n      <a href=\"home.html\" class=\"rk-brand\">\n        RegKings\n        <span>PATENT &amp; COSMETIC STORES</span>\n      </a>\n\n      <button class=\"rk-menu-btn\" type=\"button\" aria-label=\"Toggle navigation\" aria-expanded=\"false\" onclick=\"(function(b){var m=b.parentElement.querySelector('.rk-menu');var o=m.classList.toggle('rk-menu-open');b.setAttribute('aria-expanded',o?'true':'false');})(this)\">\n        ☰\n      </button>\n\n      <nav class=\"rk-menu\" aria-label=\"Main navigation\">\n        <a href=\"home.html\">Home</a>\n        <a href=\"about.html\">About</a>\n        <a href=\"pharmacy.html\">Pharmacy</a>\n        <a href=\"patents.html\">Patent Medicines</a>\n        <a href=\"cosmetics.html\" class=\"rk-active\">Cosmetics</a>\n        <a href=\"products.html\">Products</a>\n        <a href=\"contact.html\">Contact</a>\n        <a href=\"visit.html\">Visit Us</a>\n      </nav>\n\n    </div>\n  </header>\n\n  <!-- INTRODUCTION -->\n  <section data-bs-version=\"5.1\" class=\"rk-intro\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-breadcrumb\">\n        <a href=\"home.html\">Home</a> &nbsp;/&nbsp; Cosmetics\n      </div>\n\n      <div class=\"rk-intro-grid\">\n        <div>\n          <span class=\"rk-eyebrow\">More for Your Everyday Needs</span>\n\n          <h1>Personal Care Products for Everyday Living.</h1>\n\n          <p>\n            Alongside our main focus on medicines and healthcare products,\n            RegKings also offers a selection of cosmetic and personal-care\n            products. Explore the categories below and contact us to enquire\n            about available items.\n          </p>\n\n          <a href=\"contact.html\" class=\"rk-btn\">Enquire About Products</a>\n          <a href=\"#rk-categories\" class=\"rk-outline\">Explore Categories</a>\n        </div>\n\n        <div class=\"rk-intro-note\">\n          <h3>Healthcare remains our main focus.</h3>\n          <p>\n            Cosmetics and personal-care items complement our wider product\n            range, giving customers another option for their everyday needs.\n          </p>\n        </div>\n      </div>\n\n    </div>\n  </section>\n\n  <!-- COSMETICS CATEGORIES -->\n  <section class=\"rk-section rk-section-light\" id=\"rk-categories\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-section-heading\">\n        <span class=\"rk-eyebrow\">Cosmetics &amp; Personal Care</span>\n        <h2>Everyday Care Essentials</h2>\n        <p>\n          Browse these general categories to see the types of products you\n          may enquire about. Product selection and availability can vary.\n          Please contact the store to confirm current stock.\n        </p>\n      </div>\n\n      <div class=\"rk-category-grid\">\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-top\"></div>\n          <div class=\"rk-category-content\">\n            <span class=\"rk-category-label\">01 / Skin</span>\n            <h3>Skin Care</h3>\n            <p>\n              Enquire about available skin moisturisers, cleansers, and\n              other everyday skin-care products.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-top\"></div>\n          <div class=\"rk-category-content\">\n            <span class=\"rk-category-label\">02 / Hair</span>\n            <h3>Hair Care</h3>\n            <p>\n              Ask about hair-care products and accessories that may be\n              available in store.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-top\"></div>\n          <div class=\"rk-category-content\">\n            <span class=\"rk-category-label\">03 / Body</span>\n            <h3>Body Care</h3>\n            <p>\n              Explore everyday body-care products, including items intended\n              for regular personal hygiene.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-top\"></div>\n          <div class=\"rk-category-content\">\n            <span class=\"rk-category-label\">04 / Beauty</span>\n            <h3>Beauty Essentials</h3>\n            <p>\n              Enquire about selected beauty and cosmetic essentials available\n              through the store.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-top\"></div>\n          <div class=\"rk-category-content\">\n            <span class=\"rk-category-label\">05 / Hygiene</span>\n            <h3>Personal Hygiene</h3>\n            <p>\n              Ask about everyday personal-hygiene products and other\n              personal-care essentials.\n            </p>\n          </div>\n        </article>\n\n        <article class=\"rk-category\">\n          <div class=\"rk-category-top\"></div>\n          <div class=\"rk-category-content\">\n            <span class=\"rk-category-label\">06 / Enquiries</span>\n            <h3>Product Availability</h3>\n            <p>\n              Looking for a specific brand or item? Contact us to check\n              whether it is currently available.\n            </p>\n          </div>\n        </article>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- CUSTOMER INFORMATION -->\n  <section class=\"rk-info\">\n    <div class=\"rk-container rk-info-grid\">\n\n      <div>\n        <span class=\"rk-eyebrow\">Choosing Products</span>\n        <h2>Make the Right Choice for Your Needs.</h2>\n        <p>\n          Personal-care products can differ in their ingredients, intended\n          use, and suitability for different people. Read labels carefully\n          and follow the manufacturer's directions.\n        </p>\n        <p>\n          If a product causes an unexpected reaction, stop using it and seek\n          appropriate medical advice when necessary.\n        </p>\n      </div>\n\n      <div class=\"rk-info-list\">\n\n        <div class=\"rk-info-item\">\n          <h3>Check the Ingredients</h3>\n          <p>\n            Review the product label, particularly if you have known\n            sensitivities or allergies.\n          </p>\n        </div>\n\n        <div class=\"rk-info-item\">\n          <h3>Check Product Information</h3>\n          <p>\n            Follow the manufacturer's instructions and observe any\n            recommended storage conditions.\n          </p>\n        </div>\n\n        <div class=\"rk-info-item\">\n          <h3>Confirm Availability</h3>\n          <p>\n            Contact RegKings before visiting if you are looking for a\n            particular cosmetic or personal-care product.\n          </p>\n        </div>\n\n      </div>\n    </div>\n  </section>\n\n  <!-- MEDICINES REMAIN THE MAIN BUSINESS -->\n  <section class=\"rk-medicines\">\n    <div class=\"rk-container rk-medicines-inner\">\n\n      <div>\n        <h2>Looking for Medicines Instead?</h2>\n        <p>\n          Medicines and healthcare products remain our primary focus.\n          Visit our pharmacy page to learn more.\n        </p>\n      </div>\n\n      <a href=\"pharmacy.html\" class=\"rk-btn\">Explore Pharmacy</a>\n\n    </div>\n  </section>\n\n  <!-- FOOTER -->\n  <footer class=\"rk-footer\">\n    <div class=\"rk-container\">\n\n      <div class=\"rk-footer-top\">\n        <div>\n          <a href=\"home.html\" class=\"rk-brand\">\n            RegKings\n            <span>PATENT &amp; COSMETIC STORES</span>\n          </a>\n          <p>\n            Medicines first, with additional products for everyday care.\n          </p>\n        </div>\n\n        <nav class=\"rk-footer-links\" aria-label=\"Footer navigation\">\n          <a href=\"home.html\">Home</a>\n          <a href=\"about.html\">About</a>\n          <a href=\"pharmacy.html\">Pharmacy</a>\n          <a href=\"patents.html\">Patent Medicines</a>\n          <a href=\"cosmetics.html\">Cosmetics</a>\n          <a href=\"products.html\">Products</a>\n          <a href=\"contact.html\">Contact</a>\n          <a href=\"visit.html\">Visit Us</a>\n        </nav>\n      </div>\n\n      <div class=\"rk-copyright\">\n        © <span id=\"rk-year\">2026</span>\n        RegKings Patent &amp; Cosmetic Stores. All rights reserved.\n      </div>\n\n    </div>\n  </footer>\n\n</div>\n\n<script>\n(function () {\n  var year = document.getElementById(\"rk-year\");\n\n  if (year) {\n    year.textContent = new Date().getFullYear();\n  }\n})();\n</script>",
